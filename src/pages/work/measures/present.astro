---
// Slide view of the Measures case study, for presenting in interviews.
// Same copy as /work/measures (src/data/measures.ts); the draft review notes
// are left out here.
//
// Keys: ← → / Space / PageUp PageDown to move, Home End to jump, F for
// fullscreen, N for speaker notes, Esc to return to the case study page.
// Printing (Cmd+P → Save as PDF) gives one slide per page as a backup.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PainPointMap from '../../../components/case-study/PainPointMap.astro';
import RequestRanking from '../../../components/case-study/RequestRanking.astro';
import JourneyLanes from '../../../components/case-study/JourneyLanes.astro';
import AnnotatedScreen from '../../../components/case-study/AnnotatedScreen.astro';
import { Image } from 'astro:assets';
import { site } from '../../../data/site.config';
import * as cs from '../../../data/measures';
import '../../../styles/theme-meadow.css';

import userFlow from '../../../assets/work/measures/user-flow.png';

const sections = [
  'title',
  'problem',
  'goals',
  'research',
  'approach',
  'priorities',
  'journey',
  'brief',
  'flow',
  'decisions',
  ...cs.screens.map((s) => `screen-${s.id}`),
  'outcome',
  'takeaways',
  'close',
];
const num = (id: string) => String(sections.indexOf(id)).padStart(2, '0');
---

<BaseLayout
  title={`Measures (slides) | ${site.name}`}
  description="Slide presentation of the Measures case study."
  theme="theme-meadow"
>
  <div class="deck" data-deck>
    <div class="stage" data-stage>
      <article class="slide slide-title" data-id="title">
        <div class="title-body">
          <p class="eyebrow">Case study · Hatch Data</p>
          <h1>{cs.title}</h1>
          <p class="tagline">{cs.tagline}</p>
        </div>
        <div class="title-art" aria-hidden="true">
          <span class="orb orb-mint"></span>
          <span class="orb orb-sky"></span>
          <span class="orb orb-sun"></span>
        </div>
      </article>

      <article class="slide" data-id="problem">
        <h2>The problem</h2>
        <div class="two-col">
          <div>
            <p class="lead">{cs.problem.lead}</p>
            {cs.problem.body.map((p) => <p>{p}</p>)}
          </div>
          <div class="stat-card">
            <p class="stat-value">{cs.stat.value}</p>
            <p class="stat-label">{cs.stat.label}</p>
          </div>
        </div>
      </article>

      <article class="slide" data-id="goals">
        <h2>Goals</h2>
        <ol class="cards three">
          {
            cs.goals.map((g, i) => (
              <li class="card">
                <span class="card-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{g.title}</h3>
                <p>{g.body}</p>
              </li>
            ))
          }
        </ol>
      </article>

      <article class="slide" data-id="research">
        <h2>What we heard</h2>
        <div class="two-col">
          <div class="research-copy">
            {cs.research.body.map((p) => <p>{p}</p>)}
          </div>
          <div class="stat-card">
            <p class="stat-value">{cs.research.stat.value}</p>
            <p class="stat-label">{cs.research.stat.label}</p>
          </div>
        </div>
      </article>

      <article class="slide" data-id="approach">
        <h2>Finding where it breaks</h2>
        <div class="fill">
          <PainPointMap points={cs.painPoints} class="deck-lifecycle" />
        </div>
      </article>

      <article class="slide" data-id="priorities">
        <h2>Choosing what to build</h2>
        <div class="fill">
          <RequestRanking items={cs.closingRequests} class="deck-ranking" />
        </div>
      </article>

      <article class="slide" data-id="journey">
        <h2>A day in the field</h2>
        <p class="sub">
          <strong>{cs.persona.name}, {cs.persona.role.toLowerCase()}.</strong>{' '}
          {cs.persona.summary}
        </p>
        <div class="fill">
          <JourneyLanes steps={cs.journey} label={`${cs.persona.name}'s journey`} class="deck-lanes" />
        </div>
      </article>

      <article class="slide slide-statement" data-id="brief">
        <p class="eyebrow">The brief</p>
        <p class="statement">{cs.brief}</p>
      </article>

      <article class="slide slide-flow" data-id="flow">
        <h2>The whole lifecycle</h2>
        <div class="flow-frame">
          <Image
            src={userFlow}
            alt="The measure lifecycle flow from creation to M&V, with a 23-item feature list mapped onto each step and red dots marking likely drop-off points."
            widths={[1600, 2400]}
            sizes="1400px"
          />
        </div>
      </article>

      <article class="slide" data-id="decisions">
        <h2>Four design decisions</h2>
        <ol class="cards two">
          {
            cs.decisions.map((d, i) => (
              <li class="card decision">
                <span class="card-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{d.title}</h3>
                <p>{d.body[0]}</p>
                <p class="tradeoff">
                  <span>Tradeoff</span> {d.tradeoff}
                </p>
              </li>
            ))
          }
        </ol>
      </article>

      {
        cs.screens.map((screen) => (
          <article
            class:list={['slide', 'slide-screen', { 'is-tall': screen.tall }]}
            data-id={`screen-${screen.id}`}
          >
            <h2>{screen.title}</h2>
            <p class="screen-summary">{screen.summary}</p>
            <AnnotatedScreen
              src={screen.src}
              alt={screen.alt}
              callouts={screen.callouts}
              sizes={screen.tall ? '400px' : '1200px'}
            />
          </article>
        ))
      }

      <article class="slide" data-id="outcome">
        <h2>Where it landed</h2>
        <div class="outcome">
          <div class="before">
            <p class="o-label">Before</p>
            <p class="o-value">{cs.stat.value}</p>
            <p class="o-caption">of automated measures marked implemented in error</p>
          </div>
          <span class="o-arrow" aria-hidden="true">&rarr;</span>
          <div class="after">
            <p class="o-label">Six months after release</p>
            <p class="o-value">{cs.outcome.value}</p>
            <p class="o-caption">{cs.outcome.label}</p>
          </div>
        </div>
      </article>

      <article class="slide" data-id="takeaways">
        <h2>Takeaways</h2>
        <ul class="takeaways">
          {
            cs.takeaways.map((t) => (
              <li>
                <strong>{t.title}</strong> {t.body}
              </li>
            ))
          }
        </ul>
      </article>

      <article class="slide slide-title slide-close" data-id="close">
        <div class="title-body">
          <p class="eyebrow">Thank you</p>
          <h1>Questions?</h1>
          <p class="tagline">{site.email}</p>
        </div>
        <div class="title-art" aria-hidden="true">
          <span class="orb orb-mint"></span>
          <span class="orb orb-sky"></span>
          <span class="orb orb-sun"></span>
        </div>
      </article>
    </div>

    <footer class="chrome" data-chrome aria-hidden="true">
      <span class="chrome-left"><span data-num>01</span>. Measures</span>
      <span class="chrome-right"><span class="rule"></span>{site.name}</span>
    </footer>
    <div class="progress" aria-hidden="true"><span data-progress></span></div>
  </div>

  <nav class="controls" aria-label="Slide controls">
    <button type="button" data-prev aria-label="Previous slide">&larr;</button>
    <span class="count" data-count aria-live="polite">1 / {sections.length}</span>
    <button type="button" data-next aria-label="Next slide">&rarr;</button>
    <button type="button" data-notes-toggle aria-pressed="false">Notes</button>
    <button type="button" data-fullscreen>Fullscreen</button>
    <a href="/work/measures">Exit</a>
  </nav>

  <aside class="notes" data-notes hidden>
    <p class="notes-label">Speaker notes</p>
    <p data-notes-text></p>
  </aside>

  <script type="application/json" id="deck-notes" set:html={JSON.stringify(cs.notes)} />
  <script type="application/json" id="deck-nums" set:html={JSON.stringify(Object.fromEntries(sections.map((id) => [id, num(id)])))} />
</BaseLayout>

<script>
  const deck = document.querySelector<HTMLElement>('[data-deck]')!;
  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const slides = Array.from(stage.querySelectorAll<HTMLElement>('.slide'));
  const chrome = document.querySelector<HTMLElement>('[data-chrome]')!;
  const numEl = document.querySelector<HTMLElement>('[data-num]')!;
  const countEl = document.querySelector<HTMLElement>('[data-count]')!;
  const progressEl = document.querySelector<HTMLElement>('[data-progress]')!;
  const notesEl = document.querySelector<HTMLElement>('[data-notes]')!;
  const notesText = document.querySelector<HTMLElement>('[data-notes-text]')!;
  const notesToggle = document.querySelector<HTMLButtonElement>('[data-notes-toggle]')!;
  const notes: Record<string, string> = JSON.parse(
    document.getElementById('deck-notes')!.textContent || '{}'
  );
  const nums: Record<string, string> = JSON.parse(
    document.getElementById('deck-nums')!.textContent || '{}'
  );

  const W = 1600;
  const H = 900;
  let index = 0;

  // Fit the fixed 1600×900 stage to the window, leaving room for the notes
  // drawer when it is open, so every slide lays out identically on any screen.
  function fit() {
    const notesH = notesEl.hidden ? 0 : notesEl.offsetHeight;
    const scale = Math.min(window.innerWidth / W, (window.innerHeight - notesH) / H);
    deck.style.setProperty('--scale', String(scale));
  }

  function show(i: number) {
    index = Math.max(0, Math.min(slides.length - 1, i));
    slides.forEach((s, n) => {
      const active = n === index;
      s.classList.toggle('is-active', active);
      s.setAttribute('aria-hidden', String(!active));
      s.inert = !active;
    });
    const id = slides[index].dataset.id!;
    const bare = id === 'title' || id === 'close';
    chrome.classList.toggle('is-hidden', bare);
    numEl.textContent = nums[id] ?? '';
    countEl.textContent = `${index + 1} / ${slides.length}`;
    progressEl.style.width = `${((index + 1) / slides.length) * 100}%`;
    notesText.textContent = notes[id] ?? '';
    history.replaceState(null, '', `#${index + 1}`);
  }

  function toggleNotes() {
    notesEl.hidden = !notesEl.hidden;
    notesToggle.setAttribute('aria-pressed', String(!notesEl.hidden));
    fit();
  }

  function toggleFullscreen() {
    if (document.fullscreenElement) document.exitFullscreen();
    else document.documentElement.requestFullscreen?.();
  }

  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    switch (e.key) {
      case 'ArrowRight':
      case 'ArrowDown':
      case 'PageDown':
      case ' ':
        e.preventDefault();
        show(index + 1);
        break;
      case 'ArrowLeft':
      case 'ArrowUp':
      case 'PageUp':
        e.preventDefault();
        show(index - 1);
        break;
      case 'Home':
        show(0);
        break;
      case 'End':
        show(slides.length - 1);
        break;
      case 'f':
      case 'F':
        toggleFullscreen();
        break;
      case 'n':
      case 'N':
        toggleNotes();
        break;
      case 'Escape':
        if (!document.fullscreenElement) location.href = '/work/measures';
        break;
    }
  });

  // A click on the slide itself advances, the way a clicker would.
  stage.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a, button')) return;
    show(index + 1);
  });

  let touchX = 0;
  stage.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
  stage.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
  });

  document.querySelector('[data-prev]')!.addEventListener('click', () => show(index - 1));
  document.querySelector('[data-next]')!.addEventListener('click', () => show(index + 1));
  notesToggle.addEventListener('click', toggleNotes);
  document.querySelector('[data-fullscreen]')!.addEventListener('click', toggleFullscreen);
  window.addEventListener('resize', fit);

  const fromHash = parseInt(location.hash.slice(1), 10);
  fit();
  show(Number.isFinite(fromHash) ? fromHash - 1 : 0);
</script>

<style>
  /* The slide view owns the whole window: no grid paper, no sheet. Root size
     goes up so rem-based components read at presentation scale on the stage. */
  :global(html) {
    font-size: 20px;
  }

  :global(body) {
    padding: 0;
    background: var(--meadow-wash-deep);
    background-image: none;
    overflow: hidden;
  }

  :global(.page-sheet) {
    max-width: none;
    margin: 0;
    background: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  /* Slides are always fully shown; the scroll reveal doesn't apply here. */
  :global(.js) .deck :global(.reveal) {
    opacity: 1;
    transform: none;
  }

  /* Mostly white, with color only as a haze at the corners: light and open. */
  .deck {
    --scale: 1;
    --haze:
      radial-gradient(56rem 34rem at 100% 0%, var(--meadow-mint-wash) 0%, transparent 62%),
      radial-gradient(48rem 32rem at 0% 100%, var(--meadow-sky-wash) 0%, transparent 62%),
      #fff;
    position: absolute;
    top: 0;
    left: 50%;
    width: 1600px;
    height: 900px;
    transform: translateX(-50%) scale(var(--scale));
    transform-origin: top center;
    background: var(--haze);
    box-shadow: 0 30px 80px -44px rgba(30, 43, 40, 0.3);
    overflow: hidden;
  }

  .stage {
    position: absolute;
    inset: 0;
  }

  .slide {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 96px 128px 136px;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s ease,
      visibility 0s linear 0.5s;
  }

  .slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.5s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .slide,
    .slide.is-active {
      transition: none;
    }
  }

  .slide h2 {
    position: relative;
    margin-bottom: 56px;
    font-size: 60px;
    font-weight: 400;
    line-height: 1.1;
  }

  .slide h2::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -20px;
    width: 40px;
    height: 2px;
    border-radius: 2px;
    background: var(--meadow-mint);
  }

  .slide p {
    font-size: 25px;
    line-height: 1.65;
  }

  .fill {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .sub {
    max-width: 1200px;
    margin: -12px 0 24px;
    color: var(--color-text-muted);
  }

  .sub strong {
    font-weight: 600;
    color: var(--color-text);
  }

  /* Title and closing slides */
  .slide-title {
    justify-content: center;
    padding-left: 200px;
  }

  .title-body {
    position: relative;
    z-index: 1;
  }

  .slide-title h1 {
    margin-bottom: 32px;
    font-size: 156px;
    font-weight: 400;
    line-height: 1;
  }

  .slide-title .eyebrow {
    margin-bottom: 40px;
    font-size: 20px;
    color: var(--color-accent);
  }

  .tagline {
    max-width: 900px;
    font-size: 36px !important;
    line-height: 1.4 !important;
    color: var(--color-text-muted) !important;
  }

  .slide-close h1 {
    font-size: 124px;
  }

  /* Soft, overlapping circles: the product's three impact colors, blurred. */
  .title-art {
    position: absolute;
    right: 120px;
    top: 50%;
    width: 520px;
    height: 520px;
    transform: translateY(-50%);
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    opacity: 0.8;
  }

  .orb-mint {
    width: 340px;
    height: 340px;
    left: 0;
    top: 40px;
    background: radial-gradient(circle at 35% 35%, #fff 0%, var(--meadow-mint-wash) 40%, #bfe9d9 100%);
  }

  .orb-sky {
    width: 280px;
    height: 280px;
    right: 0;
    top: 0;
    background: radial-gradient(circle at 35% 35%, #fff 0%, var(--meadow-sky-wash) 40%, #c9e2f1 100%);
  }

  .orb-sun {
    width: 200px;
    height: 200px;
    right: 70px;
    bottom: 20px;
    background: radial-gradient(circle at 35% 35%, #fff 0%, var(--meadow-sun-wash) 40%, #f7e0b1 100%);
  }

  /* Problem and research */
  .two-col {
    display: grid;
    grid-template-columns: 1fr 440px;
    gap: 104px;
    align-items: center;
    flex: 1;
  }

  .lead {
    font-family: var(--font-display);
    font-size: 40px !important;
    line-height: 1.3 !important;
    color: var(--color-text) !important;
  }

  .research-copy p {
    font-size: 24px;
  }

  .stat-card {
    padding: 52px 48px;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid var(--color-border);
    box-shadow: 0 24px 60px -40px rgba(30, 43, 40, 0.25);
  }

  .stat-value {
    margin-bottom: 16px;
    font-family: var(--font-display);
    font-size: 128px !important;
    line-height: 1 !important;
    color: var(--color-accent-ink) !important;
  }

  .stat-label {
    margin: 0;
    font-size: 22px !important;
    color: var(--color-text-muted);
  }

  /* Card grids */
  .cards {
    display: grid;
    gap: 36px;
    margin: 0;
    padding: 0;
    list-style: none;
    flex: 1;
    align-content: center;
  }

  .cards.three {
    grid-template-columns: repeat(3, 1fr);
  }

  .cards.two {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px 28px;
    align-content: start;
  }

  .card {
    padding: 44px;
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid var(--color-border);
    border-radius: 24px;
    box-shadow: 0 24px 50px -40px rgba(30, 43, 40, 0.3);
  }

  .card-num {
    display: block;
    margin-bottom: 24px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    color: var(--color-accent-soft);
  }

  .card h3 {
    margin-bottom: 14px;
    font-size: 34px;
    font-weight: 500;
  }

  .card p {
    margin: 0;
    font-size: 23px;
    color: var(--color-text-muted);
  }

  .decision {
    padding: 22px 30px;
  }

  .decision .card-num {
    margin-bottom: 6px;
  }

  .decision h3 {
    margin-bottom: 8px;
    font-size: 27px;
  }

  .decision p {
    font-size: 17px;
    line-height: 1.5;
  }

  .decision .tradeoff {
    margin-top: 12px;
    padding: 10px 16px;
    border-radius: 12px;
    background: var(--color-accent-wash);
    font-size: 16px;
    color: var(--color-text);
  }

  .tradeoff span {
    font-weight: 600;
    color: var(--color-accent-ink);
  }

  /* Diagrams, tuned up from their page sizes to the stage */
  .slide :global(.deck-lifecycle) {
    gap: 6px;
    max-width: 1240px;
  }

  .slide :global(.deck-lifecycle .stage) {
    padding: 10px 20px;
    font-size: 24px;
  }

  .slide :global(.deck-lifecycle .is-focus) {
    padding: 20px;
  }

  .slide :global(.deck-lifecycle::before) {
    left: 37px;
  }

  .slide :global(.deck-lifecycle .dot) {
    width: 34px;
    height: 34px;
    font-size: 16px;
  }

  .slide :global(.deck-lifecycle .tag) {
    font-size: 14px;
  }

  .slide :global(.deck-ranking) {
    max-width: 1260px;
  }

  .slide :global(.deck-ranking .key) {
    font-size: 17px;
    margin-bottom: 20px;
  }

  .slide :global(.deck-ranking .rows) {
    gap: 12px;
  }

  .slide :global(.deck-ranking .row) {
    grid-template-columns: 560px 1fr 44px;
    gap: 28px;
    font-size: 22px;
  }

  .slide :global(.deck-ranking .detail) {
    font-size: 16px;
  }

  .slide :global(.deck-ranking .track) {
    height: 14px;
  }

  .slide :global(.deck-lanes) {
    grid-template-columns: 150px minmax(0, 1fr);
    row-gap: 24px;
  }

  .slide :global(.deck-lanes .row-labels) {
    font-size: 15px;
  }

  .slide :global(.deck-lanes .columns) {
    column-gap: 24px;
  }

  .slide :global(.deck-lanes .step),
  .slide :global(.deck-lanes .opportunity) {
    padding: 22px 24px;
    font-size: 20px;
  }

  .slide :global(.deck-lanes .num) {
    font-size: 15px;
  }

  .slide :global(.deck-lanes .chips li) {
    padding: 6px 14px;
    font-size: 16px;
  }

  /* Statement slide */
  .slide-statement {
    justify-content: center;
    padding-left: 200px;
    padding-right: 220px;
  }

  .slide-statement .eyebrow {
    font-size: 20px;
    color: var(--color-accent);
  }

  .statement {
    font-family: var(--font-display);
    font-size: 56px !important;
    line-height: 1.35 !important;
    color: var(--color-text) !important;
  }

  /* User flow: the diagram is wide, so it gets the whole stage width and as
     much height as the title leaves. */
  .slide-flow {
    padding: 72px 96px 100px;
  }

  .slide-flow h2 {
    margin-left: 32px;
    margin-bottom: 44px;
  }

  .flow-frame {
    position: relative;
    flex: 1;
    min-height: 0;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 24px;
  }

  .flow-frame :global(img) {
    position: absolute;
    inset: 12px;
    width: calc(100% - 24px);
    height: calc(100% - 24px);
    object-fit: contain;
  }

  /* Screens: image sized to the stage height, callouts beside it */
  .slide-screen {
    padding-top: 72px;
  }

  .slide-screen h2 {
    margin-bottom: 34px;
    font-size: 50px;
  }

  .screen-summary {
    margin: -4px 0 22px;
    color: var(--color-text-muted);
  }

  .slide-screen :global(.annotated) {
    grid-template-columns: auto 400px;
    column-gap: 64px;
    justify-content: start;
  }

  .slide-screen :global(.shot) {
    width: fit-content;
  }

