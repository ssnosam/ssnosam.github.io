---
// NOTE: the <ReviewNote> callouts flag copy drafted from the original deck's
// screens and flows rather than written from memory: the dates, the design
// decisions and the outcomes. They render only in local development. Copy lives in
// src/data/disclosure.ts and is shared with the slide view at ./disclosure/present.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CaseStudyHero from '../../components/case-study/CaseStudyHero.astro';
import CaseStudyMeta from '../../components/case-study/CaseStudyMeta.astro';
import StatBlock from '../../components/case-study/StatBlock.astro';
import DesignBet from '../../components/case-study/DesignBet.astro';
import ReviewNote from '../../components/case-study/ReviewNote.astro';
import DoubleDiamond from '../../components/case-study/DoubleDiamond.astro';
import JourneyMap from '../../components/case-study/JourneyMap.astro';
import AnnotatedScreen from '../../components/case-study/AnnotatedScreen.astro';
import { site } from '../../data/site.config';
import * as cs from '../../data/disclosure';
import '../../styles/theme-mist.css';

import tile from '../../assets/work/disclosure/disclosure-tile.png';
---

<BaseLayout
  title={`Disclosure | ${site.name}`}
  description="Designing Measurabl's Disclosure: compliance reporting software that helps asset managers collect, transform, and defend ESG data for frameworks like SFDR."
  theme="theme-mist"
>
  <Nav />
  <main>
    <section id="disclosure" class="intro">
      <div class="container">
        <div class="toolbar">
          <a href="/work" class="back-link">&larr; Back to my work</a>
          <a href="/work/disclosure/present" class="present-link">
            Present as slides <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <CaseStudyHero
          title={cs.title}
          summary={cs.tagline}
          art={tile}
          artAlt="An abstract report card with a completeness ring, a progress bar, and a green check mark."
        >
          <p>{cs.intro}</p>
        </CaseStudyHero>

        <div class="meta-block">
          <CaseStudyMeta items={cs.meta} />
        </div>
      </div>
    </section>

    <section id="problem">
      <div class="container split">
        <div class="prose reveal">
          <h2>The problem</h2>
          <p class="lead">{cs.problem.lead}</p>
          {cs.problem.body.map((p) => <p>{p}</p>)}
        </div>
        <div class="stat-card reveal" style="--reveal-delay: 0.08s">
          <StatBlock stats={[cs.stat]} class="single-stat" />
        </div>
      </div>
    </section>

    <section id="goals" class="wash">
      <div class="container">
        <h2 class="reveal">Goals</h2>
        <ol class="goals">
          {
            cs.goals.map((goal, i) => (
              <li class="goal reveal" style={`--reveal-delay: ${i * 0.08}s`}>
                <span class="goal-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{goal.title}</h3>
                <p>{goal.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="approach">
      <div class="container">
        <div class="prose reveal">
          <h2>Approach</h2>
          <p>
            A double diamond: research first, to make sure we were solving the right problem, then
            design and validation in short loops with the people who would use it.
          </p>
        </div>
        <div class="section-figures reveal" style="--reveal-delay: 0.08s">
          <DoubleDiamond phases={cs.approach} />
        </div>
      </div>
    </section>

    <section id="research">
      <div class="container">
        <div class="prose reveal">
          <h2>What we heard</h2>
          <p>
            Interviews with ESG specialists, asset managers, and our own advisory team kept
            returning to the same frustration: the real work happened offline, in spreadsheets
            and email, where nobody could check it.
          </p>
        </div>
        <blockquote class="quote reveal" style="--reveal-delay: 0.08s">
          <p>“{cs.quote.text}”</p>
          <footer>{cs.quote.source}</footer>
        </blockquote>
      </div>
    </section>

    <section id="journey" class="wash">
      <div class="container">
        <div class="prose reveal">
          <h2>One report, four kinds of people</h2>
          <p>
            Mapping the journey showed that a single SFDR submission passes through asset managers,
            property managers, Measurabl's own team, and outside auditors. The asset manager owns
            the report, but they can't finish it alone.
          </p>
        </div>
        <div class="section-figures reveal" style="--reveal-delay: 0.08s">
          <JourneyMap steps={cs.journey} personas={cs.personas} label="User journey" />
        </div>
      </div>
    </section>

    <section id="brief">
      <div class="container">
        <div class="prose reveal">
          <p class="eyebrow">The brief</p>
          <p class="brief">{cs.brief}</p>
        </div>
      </div>
    </section>

    <section id="flow">
      <div class="container">
        <div class="prose reveal">
          <h2>The flow we designed to</h2>
          <p>
            The main path stays on the platform from start to finish. The dashed steps happen
            alongside it: a support conversation, a bulk upload, and the auditor's review.
          </p>
        </div>
        <div class="section-figures reveal" style="--reveal-delay: 0.08s">
          <JourneyMap steps={cs.flow} label="User flow" />
        </div>
      </div>
    </section>

    <section id="decisions">
      <div class="container">
        <h2 class="reveal">Four design decisions</h2>
        <ReviewNote>
          These decisions are reconstructed from the screens and flows in the original deck. The
          choices are visible in the work, but the reasoning and the costs are inferred. Rewrite
          them in your own words before you present; interviewers push hardest here.
        </ReviewNote>
        {
          cs.decisions.map((d, i) => (
            <DesignBet title={d.title} index={i} tradeoff={d.tradeoff}>
              {d.body.map((p) => <p>{p}</p>)}
            </DesignBet>
          ))
        }
      </div>
    </section>

    <section id="product" class="wash">
      <div class="container">
        <div class="prose reveal">
          <h2>The product</h2>
          <p>Three screens carry most of the experience, from the first look to the audit.</p>
        </div>
        {
          cs.screens.map((screen) => (
            <div class="screen reveal">
              <h3>{screen.title}</h3>
              <p class="screen-summary">{screen.summary}</p>
              <AnnotatedScreen src={screen.src} alt={screen.alt} callouts={screen.callouts} />
            </div>
          ))
        }
      </div>
    </section>

    <section id="outcomes">
      <div class="container">
        <h2 class="reveal">Where it landed</h2>
        <ReviewNote>
          Drafted without hard numbers. If you can share an SUS score, early-access customer count,
          or reports submitted, put them here, since they are the strongest proof on the page.
        </ReviewNote>
        <div class="outcomes">
          {
            cs.outcomes.map((o, i) => (
              <div class="outcome reveal" style={`--reveal-delay: ${i * 0.08}s`}>
                <h3>{o.title}</h3>
                <p>{o.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="takeaways">
      <div class="container">
        <h2 class="reveal">Takeaways</h2>
        <ul class="takeaways">
          {
            cs.takeaways.map((t, i) => (
              <li class="reveal" style={`--reveal-delay: ${i * 0.06}s`}>
                <strong>{t.title}</strong> {t.body}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  main section {
    padding: var(--space-7) 0;
  }

  .intro {
    padding-top: var(--space-5);
  }

  /* Tinted bands give the long page a slow rhythm: light, then lighter. */
  .wash {
    background: linear-gradient(180deg, var(--mist-wash) 0%, var(--color-surface) 100%);
  }

  main > section.wash::before,
  main > section.wash + section::before {
    display: none;
  }

  .toolbar {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-5);
    font-size: var(--text-sm);
  }

  .present-link {
    font-weight: 500;
  }

  .meta-block {
    margin-top: var(--space-5);
  }

  .lead {
    font-size: var(--text-lg);
    color: var(--color-text);
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 19rem;
    column-gap: var(--space-7);
    align-items: center;
  }

  .stat-card {
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--mist-wash);
  }

  .stat-card :global(.single-stat) {
    grid-template-columns: 1fr;
  }

  .stat-card :global(.value) {
    font-size: clamp(3rem, 6vw, 4rem);
    color: var(--color-accent-ink);
  }

  .section-figures {
    margin-top: var(--space-5);
  }

  .goals {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .goal {
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .goal-num {
    display: block;
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    color: var(--color-accent-soft);
  }

  .goal h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .goal p {
    margin: 0;
    font-size: var(--text-sm);
  }

  .quote {
    max-width: 48rem;
    margin: var(--space-5) 0 0;
    padding-left: var(--space-5);
    border-left: 2px solid var(--mist-green);
  }

  .quote p {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.45;
    color: var(--color-text);
  }

  .quote footer {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .brief {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: 1.3;
    color: var(--color-text);
  }

  .screen {
    margin-top: var(--space-7);
  }

  .screen h3 {
    margin-bottom: var(--space-1);
  }

  .screen-summary {
    margin-bottom: var(--space-4);
  }

  .outcomes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .outcome {
    padding-top: var(--space-3);
    border-top: 2px solid var(--mist-green);
  }

  .outcome h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .outcome p {
    font-size: var(--text-sm);
  }

  .takeaways {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .takeaways li {
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-highlight);
    color: var(--color-text-muted);
  }

  .takeaways strong {
    color: var(--color-text);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
      row-gap: var(--space-5);
    }

    .goals,
    .outcomes {
      grid-template-columns: 1fr;
    }
  }
</style>
