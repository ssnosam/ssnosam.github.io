---
// Slide view of the Automated Board Reporting case study, for presenting in
// interviews. Same copy as /work/board-reporting (src/data/board-reporting.ts).
//
// Keys: ← → / Space / PageUp PageDown to move, Home End to jump, F for
// fullscreen, S for the five-minute cut, A to add the
// appendix, Esc to return to the case study page. The URL hash is the slide
// id (say #ladder), so a link opens on that slide in any mode.
// Printing (Cmd+P → Save as PDF) gives one slide per page, appendix included.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BoardCycle from '../../../components/case-study/board/BoardCycle.astro';
import AutonomyLadder from '../../../components/case-study/board/AutonomyLadder.astro';
import Milestones from '../../../components/case-study/board/Milestones.astro';
import FunctionsDiagram from '../../../components/case-study/board/FunctionsDiagram.astro';
import MockDraft from '../../../components/case-study/board/MockDraft.astro';
import MockCreate from '../../../components/case-study/board/MockCreate.astro';
import MockSection from '../../../components/case-study/board/MockSection.astro';
import MockRedline from '../../../components/case-study/board/MockRedline.astro';
import MockRollForward from '../../../components/case-study/board/MockRollForward.astro';
import MockTrust from '../../../components/case-study/board/MockTrust.astro';
import MockSchematic from '../../../components/case-study/board/MockSchematic.astro';
import { site } from '../../../data/site.config';
import * as cs from '../../../data/board-reporting';
import '../../../styles/theme-iris.css';
import '../../../styles/product-mock.css';

const main = [
  'title',
  'glance',
  'problem',
  'people',
  'challenge',
  'quote',
  'research',
  'reframe',
  'ladder',
  'foundation',
  'create',
  'drafting',
  'propose',
  'roll',
  'trust',
  'checklist',
  'beyond',
  'landed',
  'close',
];
const appendix = [
  'appendix-why',
  'appendix-timeline',
  'appendix-concept',
  'appendix-functions',
  'appendix-familiar',
  'appendix-refresh',
];
const num = (id: string) =>
  main.includes(id) ? String(main.indexOf(id)).padStart(2, '0') : `A${appendix.indexOf(id) + 1}`;

const placeKinds = ['wizard', 'editor', 'addin'] as const;
const [functionsDecision, familiarDecision, refreshDecision] = cs.mvpDecisions;
const agent = Object.fromEntries(cs.agentDecisions.map((d) => [d.id, d]));
const agentMocks = { create: MockCreate, propose: MockRedline, roll: MockRollForward };
---

<BaseLayout
  title={`${cs.title} (slides) | ${site.name}`}
  description="Slide presentation of the Automated Board Reporting case study."
  theme="theme-iris"
>
  <div class="deck" data-deck>
    <div class="stage" data-stage>
      <article class="slide slide-night slide-title" data-id="title">
        <div class="title-body">
          <p class="eyebrow">Case study · Documents intelligence platform</p>
          <h1>{cs.title}</h1>
          <p class="tagline">{cs.tagline}</p>
        </div>
        <div class="title-art" aria-hidden="true">
          <span class="ring ring-outer"></span>
          <span class="ring ring-inner"></span>
          <span class="disc"></span>
        </div>
      </article>

      <article class="slide" data-id="glance">
        <div class="glance">
          <div>
            <p class="eyebrow kicker">At a glance</p>
            <p class="glance-thesis">
              {cs.thesis.system}
              <span>{cs.thesis.person}</span>
            </p>
            <dl class="glance-meta">
              {
                cs.meta.map((m) => (
                  <div>
                    <dt>{m.label}</dt>
                    <dd>{m.lines.join(', ')}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
          <MockDraft class="glance-mock" />
        </div>
      </article>

      <article class="slide" data-id="problem">
        <p class="eyebrow kicker">The problem</p>
        <div class="problem">
          <div>
            <p class="big-stat">{cs.problem.stat.value}</p>
            <p class="big-stat-label"><strong>hours per board cycle</strong>About 75% of it spent just gathering data.</p>
          </div>
          <p class="problem-lead">{cs.problem.lead}</p>
        </div>
        <BoardCycle steps={cs.cycle} class="deck-cycle" />
      </article>

      <article class="slide" data-id="people">
        <p class="eyebrow kicker">Who it’s for</p>
        <h2>Three people, one deck.</h2>
        <ol class="people">
          {
            cs.people.map((p) => (
              <li>
                <span class="role">{p.role}</span>
                <h3>{p.job}</h3>
                <p>{p.body}</p>
              </li>
            ))
          }
        </ol>
        <p class="people-takeaway">{cs.peopleTakeaway}</p>
      </article>

      <article class="slide" data-id="challenge">
        <div class="challenge">
          <div>
            <p class="eyebrow kicker">The challenge</p>
            <h2 class="challenge-title">Four questions where a reasonable person could go either way.</h2>
          </div>
          <ol class="questions">
            {cs.questions.map((q, i) => <li class:list={{ loud: i === cs.questions.length - 1 }}>{q}</li>)}
          </ol>
        </div>
      </article>

      <article class="slide slide-night slide-quote" data-id="quote">
        <span class="quote-mark" aria-hidden="true">“</span>
        <blockquote>
          <p>{cs.quote.text}</p>
          <footer>{cs.quote.who} · {cs.quote.org}</footer>
        </blockquote>
      </article>

      <article class="slide" data-id="research">
        <p class="eyebrow kicker">What we learned</p>
        <h2>What research said about automation</h2>
        <table class="deck-table">
          <thead>
            <tr><th scope="col">What we heard</th><th scope="col" class="accent">So I…</th></tr>
          </thead>
          <tbody>
            {
              cs.learnings.map((l) => (
                <tr>
                  <td>{l.heard}</td>
                  <td class="strong">{l.so}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </article>

      <article class="slide slide-night slide-reframe" data-id="reframe">
        <p class="eyebrow">The reframe</p>
        <p class="reframe-before"><s>{cs.reframe.before}</s></p>
        <p class="reframe-after">{cs.reframe.after}</p>
        <p class="reframe-motto">{cs.tagline}</p>
      </article>

      <article class="slide" data-id="ladder">
        <p class="eyebrow kicker">Where the agent sits</p>
        <h2>{cs.ladder.title}</h2>
        <p class="sub">{cs.ladder.lead}</p>
        <div class="fill">
          <AutonomyLadder rungs={cs.ladder.rungs} class="deck-ladder" />
        </div>
      </article>

      <article class="slide" data-id="foundation">
        <div class="head-row">
          <div>
            <p class="eyebrow kicker">The foundation · Shipped, in beta</p>
            <h2>{cs.foundation.title}</h2>
            <p class="sub">{cs.foundation.lead}</p>
          </div>
          <p class="legend">
            <span class="owner system">System-owned: data and generated content</span>
            <span class="owner person">Person-owned: their deck, edits, and judgement</span>
          </p>
        </div>
        <ol class="places">
          {
            cs.foundation.places.map((p, i) => (
              <li>
                <MockSchematic kind={placeKinds[i]} class="place-mock" />
                <span class="role">{p.verb}</span>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </li>
            ))
          }
        </ol>
      </article>

      {
        (['create', 'propose', 'roll'] as const).map((id) => {
          const d = agent[id];
          const Mock = agentMocks[id];
          return (
            <article class:list={['slide', 'slide-decision', { flip: id === 'propose' }]} data-id={id}>
              <figure class="decision-visual">
                <Mock class="decision-mock" />
                {d.caption && <figcaption>{d.caption}</figcaption>}
              </figure>
              <div class="decision-copy">
                <p class="eyebrow kicker">{d.eyebrow}</p>
                <h2>{d.title}</h2>
                <dl>
                  <dt>The tension</dt>
                  <dd>{d.tension}</dd>
                  <dt class="call">The call</dt>
                  <dd class="call">{d.call}</dd>
                  <dt>The cost</dt>
                  <dd>{d.cost}</dd>
                </dl>
              </div>
            </article>
          );
        })
      }

      <article class="slide" data-id="drafting">
        <p class="eyebrow kicker">Drafting</p>
        <h2>{cs.drafting.title}</h2>
        <p class="sub">{cs.drafting.lead}</p>
        <MockSection class="drafting-mock" />
        <ol class="points">
          {
            cs.drafting.points.map((p, i) => (
              <li>
                <span class="role">{String(i + 1).padStart(2, '0')} · {p.label}</span>
                {p.body}
              </li>
            ))
          }
        </ol>
      </article>

      <article class="slide" data-id="trust">
        <p class="eyebrow kicker">The trust layer</p>
        <h2>{cs.trust.title}</h2>
        <ol class="trust">
          {
            cs.trust.parts.map((t) => (
              <li>
                <MockTrust part={t.label} class="trust-mock" />
                <span class="role">{t.label}</span>
                <h3>{t.title}</h3>
                <p>{t.body}</p>
              </li>
            ))
          }
        </ol>
      </article>

      <article class="slide" data-id="checklist">
        <p class="eyebrow kicker">How I design agentic features</p>
        <h2>{cs.checklist.title}</h2>
        <p class="sub">{cs.checklist.lead}</p>
        <table class="deck-table checklist">
          <thead>
            <tr>
              <th scope="col" colspan="2">The question</th>
              <th scope="col" class="accent">{cs.checklist.example}’s answer</th>
            </tr>
          </thead>
          <tbody>
            {
              cs.checklist.rows.map((r) => (
                <tr>
                  <th scope="row" class="row-key">{r.key}</th>
                  <td class="question">{r.question}</td>
                  <td class="strong">{r.answer}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </article>

      <article class="slide" data-id="beyond">
        <p class="eyebrow kicker">Beyond the feature</p>
        <h2>What I built that outlasts this feature.</h2>
        <ol class="beyond">
          {
            cs.beyond.map((b, i) => (
              <li>
                <span class="beyond-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{b.title}</h3>
                <p>{b.body}</p>
              </li>
            ))
          }
        </ol>
      </article>

      <article class="slide" data-id="landed">
        <div class="landed">
          <div>
            <p class="eyebrow kicker">Where it landed</p>
            {cs.landed.lines.map((l, i) => <p class:list={['landed-line', { now: i === 1 }]}>{l}</p>)}
            <p class="landed-body">{cs.landed.body}</p>
          </div>
          <div>
            <p class="eyebrow kicker">What I’d measure</p>
            <ol class="measures">
              {cs.landed.measures.map((m) => <li>{m}</li>)}
            </ol>
          </div>
        </div>
      </article>

      <article class="slide slide-night slide-title slide-close" data-id="close">
        <div class="title-body">
          <h1>Thank you!</h1>
          <p class="tagline">Questions?</p>
          <p class="contact">{site.email}</p>
        </div>
        <div class="title-art" aria-hidden="true">
          <span class="ring ring-outer"></span>
          <span class="ring ring-inner"></span>
          <span class="disc"></span>
        </div>
      </article>

      <!-- Appendix: skipped unless A is pressed, there if someone asks for depth. -->
      <article class="slide slide-appendix" data-id="appendix-why">
        <p class="eyebrow kicker">Why it mattered</p>
        <p class="statement">{cs.whyItMattered.lead}</p>
        <ul class="why">
          {cs.whyItMattered.points.map((p) => <li>{p}</li>)}
        </ul>
      </article>

      <article class="slide slide-appendix" data-id="appendix-timeline">
        <p class="eyebrow kicker">Discovery</p>
        <h2>I started wide, then converged on something we could test.</h2>
        <div class="fill">
          <Milestones items={cs.timeline} class="deck-milestones" />
        </div>
      </article>

      <article class="slide slide-appendix" data-id="appendix-concept">
        <p class="eyebrow kicker">Concept test</p>
        <h2>{cs.conceptTest.title}</h2>
        <p class="sub">{cs.conceptTest.who}</p>
        <div class="options">
          {
            cs.conceptTest.options.map((o) => (
              <figure>
                <p class="role">
                  Option {o.id} · {o.name}
                  {o.result && <span class="result">{o.result}</span>}
                </p>
                <MockSchematic kind={o.id === 'A' ? 'addin' : 'hashtag'} class="option-mock" />
              </figure>
            ))
          }
        </div>
      </article>

      {
        [
          { d: functionsDecision, id: 'appendix-functions' },
          { d: familiarDecision, id: 'appendix-familiar' },
          { d: refreshDecision, id: 'appendix-refresh' },
        ].map(({ d, id }) => (
          <article class="slide slide-appendix slide-decision" data-id={id}>
            <div class="decision-copy">
              <p class="eyebrow kicker">{d.eyebrow}</p>
              <h2>{d.title}</h2>
              <dl>
                <dt>The tension</dt>
                <dd>{d.tension}</dd>
                <dt class="call">The call</dt>
                <dd class="call">
                  {Array.isArray(d.call) ? <ul>{d.call.map((c) => <li>{c}</li>)}</ul> : d.call}
                </dd>
                <dt>The cost</dt>
                <dd>{d.cost}</dd>
              </dl>
            </div>
            <figure class="decision-visual">
              {id === 'appendix-functions' && <FunctionsDiagram class="deck-functions" />}
              {id === 'appendix-familiar' && <MockSchematic kind="addin" class="decision-mock" />}
              {id === 'appendix-refresh' && <MockRedline class="decision-mock" />}
            </figure>
          </article>
        ))
      }
    </div>

    <footer class="chrome" data-chrome aria-hidden="true">
      <span class="chrome-left"><span data-num>01</span> · <span data-section>{cs.title}</span></span>
      <span class="chrome-right"><span class="rule"></span>{site.name}</span>
    </footer>
    <div class="progress" aria-hidden="true"><span data-progress></span></div>
  </div>

  <nav class="controls" aria-label="Slide controls">
    <button type="button" data-prev aria-label="Previous slide">&larr;</button>
    <span class="count" data-count aria-live="polite">1 / {main.length}</span>
    <button type="button" data-next aria-label="Next slide">&rarr;</button>
    <button type="button" data-short-toggle aria-pressed="false" title="Five-minute cut (S)">5 min</button>
    <button type="button" data-appendix-toggle aria-pressed="false" title="Include the appendix (A)">Appendix</button>
    <button type="button" data-fullscreen title="Fullscreen (F)">Fullscreen</button>
    <a href="/work/board-reporting">Exit</a>
  </nav>

  <script type="application/json" id="deck-config" set:html={JSON.stringify({
    nums: Object.fromEntries([...main, ...appendix].map((id) => [id, num(id)])),
    main,
    appendix,
    short: cs.shortCut,
  })} />
</BaseLayout>

<script>
  type Config = {
    nums: Record<string, string>;
    main: string[];
    appendix: string[];
    short: string[];
  };

  const deck = document.querySelector<HTMLElement>('[data-deck]')!;
  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const slides = new Map(
    Array.from(stage.querySelectorAll<HTMLElement>('.slide')).map((s) => [s.dataset.id!, s])
  );
  const chrome = document.querySelector<HTMLElement>('[data-chrome]')!;
  const numEl = document.querySelector<HTMLElement>('[data-num]')!;
  const sectionEl = document.querySelector<HTMLElement>('[data-section]')!;
  const countEl = document.querySelector<HTMLElement>('[data-count]')!;
  const progressEl = document.querySelector<HTMLElement>('[data-progress]')!;
  const shortToggle = document.querySelector<HTMLButtonElement>('[data-short-toggle]')!;
  const appendixToggle = document.querySelector<HTMLButtonElement>('[data-appendix-toggle]')!;
  const config: Config = JSON.parse(document.getElementById('deck-config')!.textContent || '{}');
  const title = sectionEl.textContent;

  const W = 1600;
  const H = 900;
  let short = false;
  let withAppendix = false;
  let order: string[] = [];
  let index = 0;

  // The running order: the full talk or the five-minute cut, with the
  // appendix after the closing slide when it's switched on.
  function build() {
    const body = short ? config.short : config.main;
    order = withAppendix ? [...body, ...config.appendix] : body;
    shortToggle.setAttribute('aria-pressed', String(short));
    appendixToggle.setAttribute('aria-pressed', String(withAppendix));
  }

  // Fit the fixed 1600×900 stage to the window, so every slide lays out
  // identically on any screen.
  function fit() {
    const scale = Math.min(window.innerWidth / W, window.innerHeight / H);
    deck.style.setProperty('--scale', String(scale));
  }

  function show(i: number) {
    index = Math.max(0, Math.min(order.length - 1, i));
    const id = order[index];
    slides.forEach((s, key) => {
      const active = key === id;
      s.classList.toggle('is-active', active);
      s.setAttribute('aria-hidden', String(!active));
      s.inert = !active;
    });
    const slide = slides.get(id)!;
    const bare = id === 'title' || id === 'close';
    chrome.classList.toggle('is-hidden', bare);
    chrome.classList.toggle('on-night', slide.classList.contains('slide-night'));
    numEl.textContent = config.nums[id] ?? '';
    sectionEl.textContent = slide.classList.contains('slide-appendix') ? 'Appendix' : title;
    countEl.textContent = `${index + 1} / ${order.length}`;
    progressEl.style.width = `${((index + 1) / order.length) * 100}%`;
    history.replaceState(null, '', `#${id}`);
  }

  // Switching modes keeps you on the same slide when it's in the new order,
  // or on the nearest slide before it in the full talk when it isn't.
  function remode(change: () => void) {
    const current = order[index];
    change();
    build();
    const all = [...config.main, ...config.appendix];
    let at = order.indexOf(current);
    for (let k = all.indexOf(current); at < 0 && k >= 0; k--) at = order.indexOf(all[k]);
    show(Math.max(at, 0));
  }

  function toggleFullscreen() {
    if (document.fullscreenElement) document.exitFullscreen();
    else document.documentElement.requestFullscreen?.();
  }

  const toggleShort = () => remode(() => (short = !short));
  const toggleAppendix = () => remode(() => (withAppendix = !withAppendix));

  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    switch (e.key) {
      case 'ArrowRight':
      case 'ArrowDown':
      case 'PageDown':
      case ' ':
        e.preventDefault();
        show(index + 1);
        break;
      case 'ArrowLeft':
      case 'ArrowUp':
      case 'PageUp':
        e.preventDefault();
        show(index - 1);
        break;
      case 'Home':
        show(0);
        break;
      case 'End':
        show(order.length - 1);
        break;
      case 'f':
      case 'F':
        toggleFullscreen();
        break;
      case 's':
      case 'S':
        toggleShort();
        break;
      case 'a':
      case 'A':
        toggleAppendix();
        break;
      case 'Escape':
        if (!document.fullscreenElement) location.href = '/work/board-reporting';
        break;
    }
  });

  // A click on the slide itself advances, the way a clicker would.
  stage.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a, button')) return;
    show(index + 1);
  });

  let touchX = 0;
  stage.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
  stage.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
  });

  document.querySelector('[data-prev]')!.addEventListener('click', () => show(index - 1));
  document.querySelector('[data-next]')!.addEventListener('click', () => show(index + 1));
  shortToggle.addEventListener('click', toggleShort);
  appendixToggle.addEventListener('click', toggleAppendix);
  document.querySelector('[data-fullscreen]')!.addEventListener('click', toggleFullscreen);
  window.addEventListener('resize', fit);

  // A link straight to an appendix slide opens with the appendix on.
  const fromHash = decodeURIComponent(location.hash.slice(1));
  withAppendix = config.appendix.includes(fromHash);
  build();
  fit();
  show(Math.max(order.indexOf(fromHash), 0));
</script>

<style>
  /* The slide view owns the whole window: no grid paper, no sheet. Root size
     goes up so rem-based components read at presentation scale on the stage. */
  :global(html) {
    font-size: 20px;
  }

  :global(body) {
    padding: 0;
    background: var(--iris-wash-deep);
    background-image: none;
    overflow: hidden;
  }

  :global(.page-sheet) {
    max-width: none;
    margin: 0;
    background: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  /* Slides are always fully shown; the scroll reveal doesn't apply here. */
  :global(.js) .deck :global(.reveal) {
    opacity: 1;
    transform: none;
  }

  /* White, with blue and violet only as a haze at the corners. */
  .deck {
    --scale: 1;
    --haze:
      radial-gradient(56rem 34rem at 100% 0%, var(--iris-person-wash) 0%, transparent 62%),
      radial-gradient(48rem 32rem at 0% 100%, var(--iris-system-wash) 0%, transparent 62%),
      #fff;
    --night:
      radial-gradient(60rem 40rem at 100% 0%, rgba(138, 99, 210, 0.5) 0%, transparent 65%),
      radial-gradient(56rem 40rem at 0% 100%, rgba(74, 120, 224, 0.5) 0%, transparent 65%),
      radial-gradient(40rem 30rem at 100% 100%, rgba(201, 138, 27, 0.18) 0%, transparent 70%),
      var(--iris-night);
    position: absolute;
    top: 0;
    left: 50%;
    width: 1600px;
    height: 900px;
    transform: translateX(-50%) scale(var(--scale));
    transform-origin: top center;
    background: var(--haze);
    box-shadow: 0 30px 80px -44px rgba(29, 34, 51, 0.3);
    overflow: hidden;
  }

  .stage {
    position: absolute;
    inset: 0;
  }

  .slide {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 84px 112px 124px;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s ease,
      visibility 0s linear 0.5s;
  }

  .slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.5s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .slide,
    .slide.is-active {
      transition: none;
    }
  }

  .slide h2 {
    margin-bottom: 20px;
    font-size: 54px;
    font-weight: 400;
    line-height: 1.12;
  }

  .slide h3 {
    font-size: 30px;
    line-height: 1.2;
  }

  .slide p {
    font-size: 24px;
    line-height: 1.55;
  }

  .kicker {
    margin-bottom: 18px;
    font-size: 17px !important;
    color: var(--color-accent);
  }

  .sub {
    max-width: 1180px;
    margin: 0 0 28px;
    color: var(--color-text-muted);
  }

  .fill {
    flex: 1;
    display: flex;
