---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site, skills, tools, education, personalInterests } from '../data/site.config';

const entries = await getCollection('experience');
entries.sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf());

function formatDate(date: Date | null) {
  if (!date) return 'Current';
  return date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout title={`${site.name} — Résumé`}>
  <main class="container resume-page">
    <div class="toolbar no-print">
      <a href="/" class="back-link">&larr; Back to portfolio</a>
      <a href="/resume.pdf" download class="btn">Download PDF</a>
    </div>

    <header class="resume-header">
      <h1>{site.name}</h1>
      <p class="tagline">is a Senior Product Designer &amp; Creative in {site.location}</p>
    </header>

    <div class="resume-grid">
      <aside class="sidebar">
        <section>
          <h2>Education</h2>
          {
            education.map((item) => (
              <div class="sidebar-entry">
                <p class="school">{item.school}</p>
                <p>{item.program}</p>
                <p class="detail">{item.detail}</p>
              </div>
            ))
          }
        </section>

        <section>
          <h2>Expertise</h2>
          <ul class="plain-list">
            {skills.map((skill) => <li>{skill}</li>)}
          </ul>
        </section>

        <section>
          <h2>Familiar Tools</h2>
          <ul class="plain-list">
            {tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </section>

        <section>
          <h2>Personal Interests</h2>
          <ul class="plain-list">
            {personalInterests.map((item) => <li>{item.emoji} {item.label}</li>)}
          </ul>
        </section>
      </aside>

      <div class="main-col">
        <h2>Experience</h2>
        {
          entries.map((entry) => (
            <div class="resume-entry">
              <div class="entry-header">
                <h3>
                  {entry.data.role}, {entry.data.company}
                </h3>
                <span class="dates">
                  {formatDate(entry.data.startDate)} – {formatDate(entry.data.endDate)}
                </span>
              </div>
              {entry.data.note && <p class="note">{entry.data.note}</p>}
            </div>
          ))
        }
      </div>
    </div>

    <footer class="resume-footer">
      <p class="connect">Let's Connect!</p>
      <p>
        Say <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <p class="footer-links">
        <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={site.social.dribbble} target="_blank" rel="noopener noreferrer">Dribbble</a>
      </p>
    </footer>
  </main>
</BaseLayout>

<style>
  .resume-page {
    max-width: 60rem;
    padding-top: var(--space-5);
    padding-bottom: var(--space-8);
  }

  /* override global.css's `section { padding: 6rem 0 }` full-page rule,
     which isn't meant for these small sidebar blocks */
  .resume-page section {
    padding: 0;
  }

  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }

  .back-link {
    font-size: 0.9rem;
  }

  .resume-header {
    margin-bottom: var(--space-7);
  }

  .resume-header h1 {
    font-style: italic;
  }

  .tagline {
    font-size: 1.1rem;
    color: var(--color-text-muted);
  }

  .resume-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-7);
  }

  .sidebar section {
    margin-bottom: var(--space-6);
  }

  .sidebar h2,
  .main-col > h2 {
    font-size: 1.1rem;
    margin-bottom: var(--space-3);
  }

  .sidebar-entry .school {
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .sidebar-entry p {
    margin-bottom: var(--space-1);
  }

  .sidebar-entry .detail {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .plain-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .plain-list li {
    margin-bottom: var(--space-2);
    font-size: 0.95rem;
  }

  .main-col > h2 {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-2);
  }

  .resume-entry {
    margin-bottom: var(--space-5);
  }

  .entry-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
  }

  .entry-header h3 {
    font-size: 1.05rem;
    margin: 0;
  }

  .dates {
    font-size: 0.85rem;
    font-style: italic;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .note {
    font-style: italic;
    font-size: 0.9rem;
    margin: var(--space-1) 0 0;
  }

  .resume-footer {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .connect {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-text);
  }

  .footer-links {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
  }

  @media (max-width: 700px) {
    .resume-grid {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .no-print {
      display: none;
    }

    :global(body) {
      background: #fff;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .resume-page {
      padding-top: 0;
      padding-bottom: var(--space-3);
      max-width: none;
    }

    .resume-header {
      margin-bottom: var(--space-5);
    }

    .resume-footer {
      margin-top: var(--space-4);
      padding-top: var(--space-3);
    }

    /* CSS grid columns don't paginate cleanly across print pages,
       so stack everything into one column for the PDF/print output. */
    .resume-grid {
      display: block;
    }

    .sidebar {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--space-7);
      margin-bottom: var(--space-6);
    }

    .sidebar section {
      break-inside: avoid;
    }

    .resume-entry {
      break-inside: avoid;
    }

    .resume-footer {
      break-inside: avoid;
    }
  }
</style>
