---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { site, skills, tools, education, personalInterests } from '../data/site.config';

const entries = await getCollection('experience');
entries.sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf());

// Pre-render each entry's markdown body so the résumé shows the same
// detail as the timeline on the homepage.
const roles = await Promise.all(
  entries.map(async (entry) => ({
    data: entry.data,
    Content: (await render(entry)).Content,
  }))
);

function formatDate(date: Date | null) {
  if (!date) return 'Current';
  return date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout title={`Résumé | ${site.name}`}>
  <main class="container resume-page">
    <div class="toolbar no-print">
      <a href="/" class="back-link">&larr; Back to portfolio</a>
      <a href="/resume.pdf" download class="btn">Download PDF</a>
    </div>

    <header class="resume-header">
      <h1>{site.name}</h1>
      <p class="tagline">is a Senior Product Designer &amp; Creative in {site.location}</p>
      <p class="contact-line">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <span class="sep" aria-hidden="true">·</span>
        <span>shelby-mason.com</span>
      </p>
    </header>

    <div class="resume-grid">
      <div class="main-col">
        <h2 class="section-heading">Experience</h2>
        {
          roles.map(({ data, Content }) => (
            <article class="role">
              <div class="role-head">
                <h3>
                  {data.role} at {data.company}
                </h3>
                <span class="dates">
                  {formatDate(data.startDate)} to {formatDate(data.endDate)}
                </span>
              </div>
              {data.note && <p class="note">{data.note}</p>}
              <div class="role-body">
                <Content />
              </div>
            </article>
          ))
        }
      </div>

      <aside class="sidebar">
        <section class="side-block">
          <h2 class="section-heading">Education</h2>
          {
            education.map((item) => (
              <div>
                <p class="school">{item.school}</p>
                <p class="school-detail">{item.program}</p>
                <p class="school-detail">{item.detail}</p>
              </div>
            ))
          }
        </section>

        <section class="side-block">
          <h2 class="section-heading">Expertise</h2>
          <ul class="plain-list">
            {skills.map((skill) => <li>{skill}</li>)}
          </ul>
        </section>

        <section class="side-block">
          <h2 class="section-heading">Familiar Tools</h2>
          <ul class="plain-list">
            {tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </section>

        <section class="side-block">
          <h2 class="section-heading">Personal Interests</h2>
          <ul class="plain-list">
            {personalInterests.map((item) => (
              <li>
                <span class="interest-emoji">{item.emoji}</span> {item.label}
              </li>
            ))}
          </ul>
        </section>
      </aside>
    </div>

    <footer class="resume-footer no-print">
      <p class="connect">Let's Connect!</p>
      <p>
        Say <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </footer>
  </main>
</BaseLayout>

<style>
  .resume-page {
    max-width: 62rem;
    padding-top: var(--space-5);
    padding-bottom: var(--space-8);
  }

  /* global.css styles `section` as a full-page band; these are small blocks */
  .resume-page section {
    padding: 0;
  }

  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }

  .back-link {
    font-size: 0.9rem;
  }

  .resume-header {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .resume-header h1 {
    font-style: italic;
    margin-bottom: var(--space-2);
  }

  .tagline {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .contact-line {
    font-size: 0.9rem;
    margin: 0;
  }

  .contact-line .sep {
    color: var(--color-border);
    margin: 0 var(--space-2);
  }

  .resume-grid {
    display: grid;
    grid-template-columns: 17rem 1fr;
    column-gap: var(--space-7);
    align-items: start;
  }

  .sidebar {
    grid-column: 1;
    grid-row: 1;
  }

  .main-col {
    grid-column: 2;
    grid-row: 1;
  }

  .section-heading {
    font-size: 0.8rem;
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-accent);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  /* Experience */
  .role {
    margin-bottom: var(--space-5);
  }

  .role-head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: var(--space-3);
  }

  .role-head h3 {
    font-size: 1.05rem;
    margin: 0;
  }

  .dates {
    font-size: 0.82rem;
    font-style: italic;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .note {
    font-style: italic;
    font-size: 0.88rem;
    margin: var(--space-1) 0 var(--space-2);
  }

  .role-body :global(p) {
    margin: 0 0 var(--space-2);
  }

  .role-body :global(ul) {
    margin: 0;
    padding-left: 1.1rem;
  }

  .role-body :global(li) {
    margin-bottom: var(--space-1);
  }

  .role-body :global(li)::marker {
    color: var(--color-accent);
  }

  /* Sidebar */
  .side-block {
    margin-bottom: var(--space-6);
  }

  .school {
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .school-detail {
    font-size: 0.9rem;
    margin-bottom: var(--space-1);
  }

  .plain-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .plain-list li {
    font-size: 0.92rem;
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
  }

  .interest-emoji {
    display: inline-block;
    width: 1.4em;
  }

  .resume-footer {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .connect {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-text);
  }

  @media (max-width: 780px) {
    .resume-grid {
      grid-template-columns: 1fr;
      row-gap: var(--space-5);
    }
    .sidebar,
    .main-col {
      grid-column: 1;
      grid-row: auto;
    }
  }

  @media (max-width: 560px) {
    /* the back link and the button collide when squeezed onto one row */
    .toolbar {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
      margin-bottom: var(--space-5);
    }

    /* dates sit under the role rather than fighting it for width */
    .role-head {
      grid-template-columns: 1fr;
      row-gap: var(--space-1);
    }

    .dates {
      white-space: normal;
    }

    /* wrap between contact items, never inside an address */
    .contact-line > * {
      white-space: nowrap;
    }
  }

  @media print {
    @page {
      margin: 0.55in 0.6in;
    }

    .no-print {
      display: none;
    }

    :global(body) {
      background: #fff;
      font-size: 10.5pt;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .resume-page {
      max-width: none;
      padding: 0;
    }

    .resume-header {
      margin-bottom: var(--space-4);
      padding-bottom: var(--space-3);
    }

    .resume-header h1 {
      font-size: 26pt;
    }

    .tagline {
      font-size: 11.5pt;
      margin-bottom: var(--space-2);
    }

    .contact-line,
    .contact-line a,
    .contact-line span {
      font-size: 9pt;
      color: var(--color-text);
      text-decoration: none;
    }

    .contact-line .sep {
      color: var(--color-border);
    }

    /* Multi-column grids don't paginate across printed pages, so the
       résumé stacks: experience first, then the supporting sections. */
    .resume-grid {
      display: block;
    }

    .section-heading {
      font-size: 8.5pt;
      margin-bottom: var(--space-3);
      break-after: avoid;
    }

    .main-col {
      margin-bottom: var(--space-5);
    }

    /* Keep each job (heading, note, and bullets) on one page. */
    .role {
      break-inside: avoid;
      margin-bottom: var(--space-4);
    }

    .role-head h3 {
      font-size: 11pt;
    }

    .dates,
    .note {
      font-size: 9pt;
    }

    /* Supporting sections flow into two tidy columns under the experience.
       CSS columns (rather than grid) let short blocks pack together instead
       of leaving dead space from row alignment. */
    .sidebar {
      columns: 2;
      column-gap: var(--space-6);
    }

    .side-block {
      break-inside: avoid;
      margin-bottom: var(--space-4);
    }

    .plain-list li {
      font-size: 9.5pt;
      margin-bottom: 2pt;
    }

    .school-detail {
      font-size: 9.5pt;
    }
  }
</style>
