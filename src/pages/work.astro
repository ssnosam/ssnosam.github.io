---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Philosophy from '../components/Philosophy.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site.config';

import disclosureTile from '../assets/work/disclosure/disclosure-tile.png';

const projects = [
  {
    href: '/work/disclosure',
    title: 'Disclosure',
    disciplines: ['Product Design', 'Research', 'Compliance & Reporting'],
    summary:
      "Measurabl's compliance reporting product, helping asset managers collect, transform, and defend ESG data for frameworks like SFDR.",
    image: disclosureTile,
    imageAlt: 'Detail of a Disclosure report card showing the SFDR mark and a data completeness ring.',
  },
];
---

<BaseLayout
  title={`My Work | ${site.name}`}
  description="Selected projects and case studies from Shelby Mason, plus the principles behind how she approaches product design."
>
  <Nav />
  <main>
    <section id="work">
      <div class="container">
        <div class="prose">
          <h2 class="reveal">Work Examples</h2>
          <p class="lead reveal" style="--reveal-delay: 0.08s">
            The projects below cover the problems, the process, and what I learned along the way.
          </p>
          <p class="reveal" style="--reveal-delay: 0.12s">
            More are on the way. In the meantime, my <a href="/resume">résumé</a> covers the rest of
            the work in brief, and I'm always happy to walk through any of it in person.
          </p>
        </div>

        <div class="projects">
          {
            projects.map((project, i) => (
              <ProjectCard
                href={project.href}
                title={project.title}
                disciplines={project.disciplines}
                summary={project.summary}
                image={project.image}
                imageAlt={project.imageAlt}
                class="reveal"
                style={`--reveal-delay: ${0.16 + i * 0.08}s`}
              />
            ))
          }
        </div>

        <a href={`mailto:${site.email}`} class="btn ask">Ask me about my work</a>
      </div>
    </section>
    <Philosophy />
  </main>
  <Footer />
</BaseLayout>

<style>
  .lead {
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }

  .projects {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-6) 0;
  }

  .ask {
    margin-top: var(--space-2);
  }
</style>
