---
import { getCollection } from 'astro:content';
import TimelineItem from './TimelineItem.astro';

// Paid roles and volunteer roles run down one timeline, ordered by when each
// began. The two collections name their fields differently, so they are
// normalised here and the kind is carried through for the badge.
const jobs = await getCollection('experience');
const volunteering = await getCollection('volunteering');

const work = [
  ...jobs.map((entry) => ({
    entry,
    title: entry.data.company,
    role: entry.data.role,
    startDate: entry.data.startDate,
    endDate: entry.data.endDate,
    note: entry.data.note,
    summary: entry.data.summary,
    kind: 'work' as const,
  })),
].sort((a, b) => b.startDate.valueOf() - a.startDate.valueOf());

const volunteer = [
  ...volunteering.map((entry) => ({
    entry,
    title: entry.data.organization,
    role: entry.data.role,
    startDate: entry.data.startDate,
    endDate: entry.data.endDate,
    note: undefined,
    summary: entry.data.summary,
    kind: 'volunteer' as const,
  })),
].sort((a, b) => b.startDate.valueOf() - a.startDate.valueOf());

const columns = [
  { label: 'Professional', items: work },
  { label: 'Volunteer', items: volunteer },
];
---

<section id="experience">
  <div class="container">
    <h2 class="reveal">
      Experience
      <span class="heading-emoji" aria-hidden="true">🌱</span>
    </h2>
    <div class="timeline-columns">
      {
        columns.map((column) => (
          <div class="timeline-column">
            <h3 class="column-label reveal">{column.label}</h3>
            <div class="timeline">
              {column.items.map((item, i) => (
                <TimelineItem item={item} index={i} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Stacked by default: one track after the other, each with the full-width
     date gutter. */
  .timeline-columns {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: var(--space-6);
    align-items: start;
    margin-top: var(--space-5);
  }

  .timeline {
    max-width: 50rem;
  }

  .column-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  /* Side by side only when the page is genuinely wide. Two tracks halve the
     width available to each, so the date gutter has to pull in: below about
     1100px the descriptions drop under 45 characters a line, which is why
     the columns wait for the room rather than appearing at tablet size. */
  @media (min-width: 1100px) {
    .timeline-columns {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-4);
      row-gap: 0;
      /* wide enough for the longest stamp, "– Mar 2024", without clipping */
      --timeline-dates-col: 4.75rem;
      --timeline-rail-gap: var(--space-2);
    }

    .timeline {
      max-width: none;
    }
  }
</style>
