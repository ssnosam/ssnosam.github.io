---
import { getCollection } from 'astro:content';
import TimelineItem from './TimelineItem.astro';

// Paid roles and volunteer roles run down one timeline, ordered by when each
// began. The two collections name their fields differently, so they are
// normalised here and the kind is carried through for the badge.
const jobs = await getCollection('experience');
const volunteering = await getCollection('volunteering');

const items = [
  ...jobs.map((entry) => ({
    entry,
    title: entry.data.company,
    role: entry.data.role,
    startDate: entry.data.startDate,
    endDate: entry.data.endDate,
    note: entry.data.note,
    kind: 'work' as const,
  })),
  ...volunteering.map((entry) => ({
    entry,
    title: entry.data.organization,
    role: entry.data.role,
    startDate: entry.data.startDate,
    endDate: entry.data.endDate,
    note: undefined,
    kind: 'volunteer' as const,
  })),
].sort((a, b) => b.startDate.valueOf() - a.startDate.valueOf());
---

<section id="experience">
  <div class="container">
    <h2 class="reveal">
      Experience
      <span class="heading-emoji" aria-hidden="true">🌱</span>
    </h2>
    <div class="timeline">
      {items.map((item, i) => <TimelineItem item={item} index={i} />)}
    </div>
  </div>
</section>

<style>
  .timeline {
    margin-top: var(--space-5);
    /* wider than plain prose, since the dates column now takes a share of it,
       leaving the descriptions at a comfortable measure */
    max-width: 50rem;
  }
</style>
