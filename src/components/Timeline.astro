---
import { getCollection } from 'astro:content';
import TimelineItem from './TimelineItem.astro';

// Paid roles and volunteer roles run down one timeline, ordered by when each
// began. The two collections name their fields differently, so they are
// normalised here and the kind is carried through for the badge.
const jobs = await getCollection('experience');
const volunteering = await getCollection('volunteering');

const work = [
  ...jobs.map((entry) => ({
    entry,
    title: entry.data.company,
    role: entry.data.role,
    startDate: entry.data.startDate,
    endDate: entry.data.endDate,
    note: entry.data.note,
    kind: 'work' as const,
  })),
].sort((a, b) => b.startDate.valueOf() - a.startDate.valueOf());

const volunteer = [
  ...volunteering.map((entry) => ({
    entry,
    title: entry.data.organization,
    role: entry.data.role,
    startDate: entry.data.startDate,
    endDate: entry.data.endDate,
    note: undefined,
    kind: 'volunteer' as const,
  })),
].sort((a, b) => b.startDate.valueOf() - a.startDate.valueOf());

const columns = [
  { label: 'Professional', items: work },
  { label: 'Volunteer', items: volunteer },
];
---

<section id="experience">
  <div class="container">
    <h2 class="reveal">
      Experience
      <span class="heading-emoji" aria-hidden="true">🌱</span>
    </h2>
    <div class="timeline-columns">
      {
        columns.map((column) => (
          <div class="timeline-column">
            <h3 class="column-label reveal">{column.label}</h3>
            <div class="timeline">
              {column.items.map((item, i) => (
                <TimelineItem item={item} index={i} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Two tracks side by side. Each column is roughly half the page, so the
     date gutter is pulled in tight: at the full-width 9.5rem it would leave
     the descriptions around 33 characters a line, well under a readable
     measure. */
  .timeline-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-4);
    align-items: start;
    margin-top: var(--space-5);
    /* wide enough for the longest stamp, "– Mar 2024", without clipping */
    --timeline-dates-col: 4.75rem;
    --timeline-rail-gap: var(--space-2);
  }

  .column-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  /* Stacked, the columns get the page to themselves, so the full-width
     gutter comes back. */
  @media (max-width: 900px) {
    .timeline-columns {
      grid-template-columns: 1fr;
      row-gap: var(--space-6);
      --timeline-dates-col: 9.5rem;
      --timeline-rail-gap: var(--space-4);
    }

    .timeline {
      max-width: 50rem;
    }
  }
</style>
