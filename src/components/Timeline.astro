---
import { getCollection } from 'astro:content';
import TimelineItem from './TimelineItem.astro';

const entries = await getCollection('experience');
entries.sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf());
---

<section id="experience">
  <div class="container">
    <h2>
      Experience
      <span class="heading-emoji" aria-hidden="true">🌱</span>
    </h2>
    <div class="timeline">
      {entries.map((entry) => <TimelineItem entry={entry} />)}
    </div>
  </div>
</section>

<style>
  .timeline {
    margin-top: var(--space-5);
    /* wider than plain prose, since the dates column now takes a share of it,
       leaving the descriptions at a comfortable measure */
    max-width: 50rem;
  }

  .heading-emoji {
    font-size: 0.55em;
    vertical-align: middle;
  }
</style>
