---
import { Image } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  title: string;
  disciplines: string[];
  summary: string;
  image: ImageMetadata;
  imageAlt: string;
}

// `rest` carries the reveal delay the index sets per card.
const {
  href,
  title,
  disciplines,
  summary,
  image,
  imageAlt,
  class: className = '',
  ...rest
} = Astro.props;
---

<a class:list={['card', className]} href={href} {...rest}>
  <div class="card-art">
    <Image src={image} alt={imageAlt} widths={[240, 480]} sizes="(max-width: 640px) 30vw, 12rem" />
  </div>

  <div class="card-copy">
    <h3>{title}</h3>
    <p class="disciplines">{disciplines.join(' · ')}</p>
    <p class="summary">{summary}</p>
    <span class="cta">
      View project
      <span class="arrow" aria-hidden="true">&rarr;</span>
    </span>
  </div>
</a>

<style>
  .card {
    display: grid;
    grid-template-columns: 12rem 1fr;
    column-gap: var(--space-5);
    align-items: center;
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: inherit;
    transition:
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .card:hover {
    text-decoration: none;
    transform: translateY(-3px);
    border-color: var(--color-accent-soft);
    box-shadow: 0 14px 30px rgba(43, 34, 38, 0.08);
  }

  .card:focus-visible {
    outline: 2px solid var(--color-accent-ink);
    outline-offset: 3px;
  }

  .card-art {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .card-art :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  h3 {
    margin-bottom: var(--space-1);
  }

  .disciplines {
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-accent);
  }

  .summary {
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
  }

  .arrow {
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .card:hover .arrow {
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .card {
      grid-template-columns: 1fr;
      row-gap: var(--space-3);
    }

    .card-art {
      width: 7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .arrow {
      transition: none;
    }

    .card:hover {
      transform: none;
    }

    .card:hover .arrow {
      transform: none;
    }
  }
</style>
