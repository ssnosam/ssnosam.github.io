---
const principles = [
  {
    title: 'Design is a pillar, not a service',
    body: "I push for design to sit as an equal partner alongside product and engineering, a three-legged stool rather than an afterthought. In practice that's meant driving teams onto a shared design tool, running weekly critiques, and opening public feedback channels so design decisions stay visible and collaborative.",
  },
  {
    title: 'Measure both the numbers and the narrative',
    body: 'Success is quantitative and qualitative at once. I look at usage data and business metrics alongside direct feedback from users and internal teams, and I weigh accessibility and sustainability as real success criteria, not nice-to-haves.',
  },
  {
    title: 'Iterate in the open',
    body: 'Sustainable process beats a perfect first draft. I favor tight feedback loops like brainstorms, hackathons, and retrospectives that make it easy to course-correct quickly instead of committing hard to an early idea.',
  },
];
---

<section id="philosophy">
  <div class="container">
    <div class="prose">
      <h2>
        Design philosophy
        <span class="heading-emoji" aria-hidden="true">✨</span>
      </h2>
      <p class="lead">
        I work closely with customers, product managers, and engineers to validate hypotheses and
        proposed solutions. It's a multidisciplinary effort grounded in empathy, curiosity, and
        iteration.
      </p>
    </div>
    <div class="principles">
      {
        principles.map((p) => (
          <div class="principle">
            <div class="title-note">
              <span class="tape" aria-hidden="true" />
              <h3>
                <span class="highlight">{p.title}</span>
              </h3>
            </div>
            <p>{p.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .lead {
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    margin: 0;
  }

  /* Two columns rather than three: at three the body copy drops to roughly 30
     characters a line, well under a comfortable measure. */
  .principles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
    align-items: start;
    margin: var(--space-6) 0 0;
  }

  /* The note carries only the title; the body sits on the page beneath it. */
  .title-note {
    position: relative;
    width: 100%;
    max-width: 19rem;
    /* tall enough for the longest title's three lines, so every note is the
       same height and the paragraphs beneath them start on a shared line */
    min-height: 11.5rem;
    padding: var(--space-5) var(--space-4) var(--space-4);
    background: var(--color-note);
    border: 1px solid var(--color-note-edge);
    box-shadow: 3px 4px 10px rgba(43, 34, 38, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Slight, uneven tilts so the notes look placed by hand. */
  .principle:nth-child(1) .title-note {
    transform: rotate(-1.8deg);
  }

  .principle:nth-child(2) .title-note {
    transform: rotate(1.4deg);
  }

  .principle:nth-child(3) .title-note {
    transform: rotate(-1deg);
  }

  .tape {
    position: absolute;
    top: -0.55rem;
    left: 50%;
    width: 3.25rem;
    height: 1.1rem;
    transform: translateX(-50%) rotate(-3deg);
    background: rgba(43, 34, 38, 0.82);
  }

  .principle:nth-child(2) .tape {
    transform: translateX(-50%) rotate(2.5deg);
  }

  /* Cedarville has a small x-height and fine strokes, so the handwritten
     title needs more size and leading than the print scale would give it.
     The faint counter-rotation keeps it from sitting square to the paper. */
  .title-note h3 {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.65;
    color: var(--color-ink);
    text-align: center;
    transform: rotate(-1deg);
  }

  .principle > p {
    margin: var(--space-4) 0 0;
    line-height: var(--leading-body);
  }

  @media (max-width: 800px) {
    .principles {
      grid-template-columns: 1fr;
    }

    .principle > p {
      max-width: 34rem;
    }
  }

  .heading-emoji {
    font-size: 0.55em;
    vertical-align: middle;
  }
</style>
