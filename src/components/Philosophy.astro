---
const principles = [
  {
    title: 'Design is a pillar, not a service',
    body: "I push for design to sit as an equal partner alongside product and engineering, a three-legged stool rather than an afterthought. In practice that's meant driving teams onto a shared design tool, running weekly critiques, and opening public feedback channels so design decisions stay visible and collaborative.",
  },
  {
    title: 'Measure both the numbers and the narrative',
    body: 'Success is quantitative and qualitative at once. I look at usage data and business metrics alongside direct feedback from users and internal teams, and I weigh accessibility and sustainability as real success criteria, not nice-to-haves.',
  },
  {
    title: 'Iterate in the open',
    body: 'Sustainable process beats a perfect first draft. I favor tight feedback loops like brainstorms, hackathons, and retrospectives that make it easy to course-correct quickly instead of committing hard to an early idea.',
  },
];
---

<section id="philosophy">
  <div class="container prose">
    <h2>
      <span class="highlight">Design philosophy</span>
      <span class="heading-emoji" aria-hidden="true">✨</span>
    </h2>
    <p class="lead">
      I work closely with customers, product managers, and engineers to validate hypotheses and
      proposed solutions. It's a multidisciplinary effort grounded in empathy, curiosity, and
      iteration.
    </p>
    <div class="principles">
      {
        principles.map((p) => (
          <div class="principle">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .lead {
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    margin: 0;
  }

  .principles {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-6) 0 0;
  }

  .principle h3 {
    font-size: var(--text-h3);
    margin-bottom: var(--space-2);
  }

  .principle p {
    margin: 0;
  }

  .heading-emoji {
    font-size: 0.55em;
    vertical-align: middle;
  }
</style>
