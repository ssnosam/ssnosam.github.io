---
/**
 * Brief page-load animation: an 8-bit Siamese cat and Dutch rabbit either side
 * of a loading bar. The sprites are character maps rendered one rect per
 * pixel, so the art is exact rather than approximated with paths, and the bar
 * advances in whole pixels via a stepped animation.
 *
 * It dismisses itself in CSS, so a JS failure can never leave a visitor
 * staring at a covered page.
 */

const PALETTE: Record<string, string> = {
  K: '#14181a', // outline
  D: '#6b4636', // point / Dutch brown
  C: '#f0d6a8', // cream coat
  B: '#4a86c8', // eye
  W: '#fdfaf6', // white
  P: '#e98d8d', // pink
};

const CAT = [
  '...KK.......KK..',
  '..KDDK.....KDDK.',
  '..KDDDKKKKKDDDK.',
  '..KDDDDDDDDDDDK.',
  '..KDCCCCCCCCCDK.',
  '.KCCCCCCCCCCCCK.',
  '.KCCBCCCCCCBCCK.',
  '.KCCBCCCCCCBCCK.',
  '.KCCCCCDDCCCCCK.',
  '..KCCCCPPCCCCK..',
  '...KKCCCCCCKK...',
  '....KCCCCCCK....',
  '...KCCCCCCCCK...',
  '..KCCCCCCCCCCK..',
  '..KDDKCCCCKDDK..',
  '..KKKKKKKKKKKK..',
];

const RABBIT = [
  '...KK...KK......',
  '..KDDK.KDDK.....',
  '..KDPK.KDPK.....',
  '..KDPK.KDPK.....',
  '..KDDKKKDDK.....',
  '..KDDDDDDDK.....',
  '.KDDDDDDDDDK....',
  '.KDWKDDDDDDK....',
  '.KDDDDDDDDDK....',
  '..KKDDDDDKK.....',
  '..KWWWWWWWKK....',
  '.KWWWWWWWWWDDK..',
  'KWWWWWWWWWDDDDK.',
  'KWWKWWKWWWDDDDK.',
  '.KKKKKKKKKKKKKK.',
  '................',
];

/** one rect per opaque pixel, offset to where the sprite sits in the scene */
function pixels(map: string[], ox: number, oy: number) {
  const out: { x: number; y: number; fill: string }[] = [];
  map.forEach((row, y) =>
    row.split('').forEach((ch, x) => {
      if (ch !== '.') out.push({ x: ox + x, y: oy + y, fill: PALETTE[ch] });
    })
  );
  return out;
}

const catPixels = pixels(CAT, 2, 4);
const rabbitPixels = pixels(RABBIT, 46, 4);
const BAR = { x: 22, y: 12, w: 22, h: 5 };
---

<div class="loader" id="site-loader" aria-hidden="true">
  <svg
    class="scene"
    viewBox="0 0 64 22"
    width="512"
    height="176"
    shape-rendering="crispEdges"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <clipPath id="barClip">
        <rect class="clip-rect" x={BAR.x + 1} y={BAR.y + 1} width={BAR.w - 2} height={BAR.h - 2} />
      </clipPath>
    </defs>

    <g class="sprite sprite-cat">
      {catPixels.map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill={p.fill} />)}
    </g>

    <!-- loading bar: outlined box with a stepped fill -->
    <rect x={BAR.x} y={BAR.y} width={BAR.w} height={BAR.h} fill="#14181a" />
    <rect x={BAR.x + 1} y={BAR.y + 1} width={BAR.w - 2} height={BAR.h - 2} fill="#fdfaf6" />
    <rect
      class="bar-fill"
      x={BAR.x + 1}
      y={BAR.y + 1}
      width={BAR.w - 2}
      height={BAR.h - 2}
      fill="#e98d8d"
      clip-path="url(#barClip)"
    />

    <g class="sprite sprite-rabbit">
      {rabbitPixels.map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill={p.fill} />)}
    </g>
  </svg>

  <p class="loader-note">just a moment</p>
</div>

<script is:inline>
  (function () {
    var el = document.getElementById('site-loader');
    if (!el) return;
    try {
      sessionStorage.setItem('sm-loader-seen', '1');
    } catch (e) {
      /* private mode: the loader simply shows again next time */
    }
    window.setTimeout(function () {
      el.remove();
    }, 2000);
  })();
</script>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    background: var(--color-bg);
    /* dismisses on its own, with or without JavaScript */
    animation: loader-out 1.5s ease-in 1.05s forwards;
  }

  .scene {
    /* 384 is 6x the 64-pixel artboard, so pixels stay square and even */
    width: min(384px, 86vw);
    height: auto;
    /* keep the pixels hard-edged when the sprite is scaled up */
    image-rendering: pixelated;
  }

  /* whole-pixel fill: one step per pixel of bar interior */
  .clip-rect {
    transform-box: fill-box;
    transform-origin: left center;
    animation: fill 2s steps(20, end) infinite;
  }

  /* sprites bob a whole pixel at a time, on offset beats */
  .sprite-cat {
    animation: bob 0.8s steps(2, jump-none) infinite alternate;
  }

  .sprite-rabbit {
    animation: bob 0.56s steps(2, jump-none) infinite alternate;
  }

  @keyframes fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes bob {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-1px);
    }
  }

  .loader-note {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1.15rem;
    color: var(--color-text-muted);
  }

  @keyframes loader-out {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  /* Returning within the same tab session, or preferring less motion:
     skip the animation entirely. */
  :global(html.loader-seen) .loader {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .loader {
      display: none;
    }
  }
</style>
