---
/**
 * Brief page-load animation: a line-drawn cat and rabbit watching a loading
 * bar fill. Clean 2D linework, no filters or gradients — at this size flat
 * line art stays legible where rendered shading turns to mush.
 *
 * It dismisses itself in CSS, so a JS failure can never leave a visitor
 * staring at a covered page.
 */
---

<div class="loader" id="site-loader" aria-hidden="true">
  <svg
    class="scene"
    viewBox="0 0 320 150"
    width="320"
    height="150"
    fill="none"
    stroke="#2b2226"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <!-- a plain rect does the wiping, so the fill keeps its round ends -->
      <clipPath id="barClip">
        <rect class="clip-rect" x="128" y="84" width="76" height="15" />
      </clipPath>
    </defs>

    <!-- ── Siamese cat: lean seated profile, large ears, fine hatching
             standing in for the points ── -->
    <g class="cat">
      <!-- tail, hinged where it meets the haunch -->
      <path class="tail" d="M88 114c12 1 18-6 17-15-1-6-5-9-9-8" stroke-width="1.6" />


      <!-- body: narrow chest, haunch swelling behind -->
      <path
        d="M56 118c-4-13-3-26 3-34 5-6 13-8 20-6 9 2 14 10 14 20 0 8-2 15-5 20z"
        fill="#fdf8f8"
      />
      <!-- haunch and foreleg contours -->
      <path d="M82 118c2-9 3-18 1-25" stroke-width="0.9" opacity="0.6" />
      <path d="M64 118v-11M72 118v-11" stroke-width="1.1" />

      <!-- head, then ears over it: the ear fill covers the skull line so
           they read as part of the head rather than floating above it -->
      <ellipse cx="70" cy="70" rx="15" ry="16" fill="#fdf8f8" />
      <path d="M56 60l-3-25 17 15" fill="#fdf8f8" />
      <path d="M84 59l6-24-14 13" fill="#fdf8f8" />
      <path d="M59 55l-2-13 8 8M82 54l3-12-7 6" stroke-width="0.8" opacity="0.7" />

      <!-- almond eyes -->
      <g class="blink">
        <path d="M60 68c2-3 6-3 8 0-2 3-6 3-8 0zM74 68c2-3 6-3 8 0-2 3-6 3-8 0z" stroke-width="1.1" />
      </g>
      <circle cx="64" cy="68.2" r="0.9" fill="#2b2226" stroke="none" />
      <circle cx="78" cy="68.2" r="0.9" fill="#2b2226" stroke="none" />

      <!-- muzzle -->
      <path d="M68.6 76h2.8l-1.4 1.8z" fill="#2b2226" stroke-width="0.9" />
      <path d="M70 78c-1.6 1.8-4 1-4-1M70 78c1.6 1.8 4 1 4-1" stroke-width="0.9" />
      <g stroke-width="0.7" opacity="0.8">
        <path d="M58 76l-12-3M58 79l-11 3M82 76l12-3M82 79l11 3" />
      </g>

      <!-- whip shading: the mask and points, suggested rather than filled -->
      <g stroke-width="0.7" opacity="0.5">
        <path d="M60 60c3-2 6-3 10-3s7 1 10 3" />
        <path d="M62 63c3-2 5-2 8-2s5 0 8 2" />
        <path d="M86 110c2-6 2-12 1-17" />
        <path d="M89 108c1-5 1-10 0-14" />
      </g>
    </g>

    <!-- ── loading bar ── -->
    <rect x="128" y="84" width="76" height="15" rx="7.5" fill="#fdf8f8" />
    <rect
      class="bar-fill"
      x="128"
      y="84"
      width="76"
      height="15"
      rx="7.5"
      fill="#e7c3d2"
      stroke="none"
      clip-path="url(#barClip)"
    />
    <rect x="128" y="84" width="76" height="15" rx="7.5" />

    <!-- ── Dutch rabbit: compact seated form, saddle and blaze drawn as
             boundaries rather than blocks of colour ── -->
    <g class="rabbit">
      <!-- body -->
      <path
        d="M226 118c-3-14 2-27 12-32 8-4 18-2 24 5 6 8 7 19 4 27z"
        fill="#fdf8f8"
      />
      <!-- cotton tail -->
      <circle cx="268" cy="104" r="6.5" fill="#fdf8f8" />
      <!-- forelegs -->
      <path d="M238 118v-9M250 118v-9" stroke-width="1.1" />

      <!-- head, then ears over it -->
      <ellipse cx="242" cy="76" rx="13" ry="12.5" fill="#fdf8f8" />
      <g class="ears">
        <path d="M238 68c-5-17-6-29-2-32 4-2 8 11 9 25" fill="#fdf8f8" />
        <path d="M250 66c2-16 6-28 10-29 4 0 3 13-2 25" fill="#fdf8f8" />
        <path d="M240 62c-3-11-4-19-2-21M250 60c2-11 4-18 6-19" stroke-width="0.8" opacity="0.7" />
      </g>

      <!-- the Dutch saddle boundary across the shoulder -->
      <path d="M252 92c3 8 3 18 1 26" stroke-width="1" opacity="0.75" />

      <!-- eye, nose, whiskers -->
      <circle cx="236" cy="74" r="2.4" stroke-width="1.1" />
      <circle cx="236" cy="74" r="0.9" fill="#2b2226" stroke="none" />
      <path d="M230.4 81h2.4l-1.2 1.6z" fill="#2b2226" stroke-width="0.8" />
      <g stroke-width="0.7" opacity="0.8">
        <path d="M228 82l-11-2M228 85l-10 3" />
      </g>

      <!-- whip shading on the saddle -->
      <g stroke-width="0.7" opacity="0.45">
        <path d="M256 96c2 7 2 15 1 21" />
        <path d="M260 99c1 6 1 12 0 17" />
      </g>
    </g>

    <!-- ground line -->
    <path d="M30 118h262" stroke-width="1.2" opacity="0.4" />
  </svg>

  <p class="loader-note">just a moment</p>
</div>

<script is:inline>
  (function () {
    var el = document.getElementById('site-loader');
    if (!el) return;
    try {
      sessionStorage.setItem('sm-loader-seen', '1');
    } catch (e) {
      /* private mode: the loader simply shows again next time */
    }
    window.setTimeout(function () {
      el.remove();
    }, 2000);
  })();
</script>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    background: var(--color-bg);
    /* dismisses on its own, with or without JavaScript */
    animation: loader-out 1.5s ease-in 1.05s forwards;
  }

  .scene {
    width: min(320px, 82vw);
    height: auto;
  }

  /* the bar wipes left to right, then holds full for a beat */
  .clip-rect {
    transform-box: fill-box;
    transform-origin: left center;
    animation: fill 1.9s cubic-bezier(0.45, 0, 0.25, 1) infinite;
  }

  /* tail wag */
  .tail {
    transform-box: fill-box;
    transform-origin: 0% 100%;
    animation: wag 0.62s ease-in-out infinite alternate;
  }

  /* a slow blink, and the rabbit's ears twitch on a different beat */
  .blink {
    transform-box: fill-box;
    transform-origin: center;
    animation: blink 2.4s steps(1, end) infinite;
  }

  .ears {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: twitch 1.7s ease-in-out infinite;
  }

  @keyframes fill {
    0% {
      transform: scaleX(0);
    }
    72% {
      transform: scaleX(1);
    }
    100% {
      transform: scaleX(1);
    }
  }

  @keyframes wag {
    from {
      transform: rotate(-10deg);
    }
    to {
      transform: rotate(16deg);
    }
  }

  @keyframes blink {
    0%,
    92%,
    100% {
      transform: scaleY(1);
    }
    94%,
    98% {
      transform: scaleY(0.15);
    }
  }

  @keyframes twitch {
    0%,
    70%,
    100% {
      transform: rotate(0deg);
    }
    78% {
      transform: rotate(-4deg);
    }
    86% {
      transform: rotate(2.5deg);
    }
  }

  .loader-note {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1.3rem;
    color: var(--color-text-muted);
  }

  @keyframes loader-out {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  /* Returning within the same tab session, or preferring less motion:
     skip the animation entirely. */
  :global(html.loader-seen) .loader {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .loader {
      display: none;
    }
  }
</style>
