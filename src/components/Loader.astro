---
/**
 * Brief page-load animation: a Dutch rabbit chasing a Siamese cat, drawn in a
 * black-and-grey tattoo style — fine ink linework with stippled shading.
 * Original artwork; the treatment follows the conventions of the style rather
 * than any particular tattooer's design.
 *
 * It dismisses itself in CSS, so a JS failure can never leave a visitor
 * staring at a covered page.
 */
---

<div class="loader" id="site-loader" aria-hidden="true">
  <svg class="loader-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <!-- ── ink treatment ──────────────────────────────────────
           Hard-thresholded dots read as noise at this size, so tone is
           carried by flat greys and the filter only supplies a hand-drawn
           wobble plus a fine grain, multiplied so it darkens the wash
           rather than punching holes in it. -->
      <filter id="tattoo" x="-15%" y="-15%" width="130%" height="130%">
        <feTurbulence type="fractalNoise" baseFrequency="0.07" numOctaves="2" seed="4" result="w" />
        <feDisplacementMap
          in="SourceGraphic"
          in2="w"
          scale="0.9"
          xChannelSelector="R"
          yChannelSelector="G"
          result="drawn"
        />
        <feTurbulence type="fractalNoise" baseFrequency="1.1" numOctaves="2" seed="13" result="n" />
        <feColorMatrix in="n" type="saturate" values="0" result="grey" />
        <feComponentTransfer in="grey" result="soft">
          <feFuncA type="linear" slope="0.14" />
        </feComponentTransfer>
        <feComposite in="soft" in2="drawn" operator="in" result="grain" />
        <feBlend in="drawn" in2="grain" mode="multiply" />
      </filter>

      <!-- graded washes: dense where the form turns away, fading to bare paper -->
      <linearGradient id="toneDeep" x1="0.1" y1="0" x2="0.9" y2="1">
        <stop offset="0" stop-color="#241f23" stop-opacity="1" />
        <stop offset="0.65" stop-color="#2a2529" stop-opacity="0.72" />
        <stop offset="1" stop-color="#2a2529" stop-opacity="0.22" />
      </linearGradient>
      <linearGradient id="toneMid" x1="0.2" y1="0" x2="0.9" y2="1">
        <stop offset="0" stop-color="#2a2529" stop-opacity="0.6" />
        <stop offset="1" stop-color="#2a2529" stop-opacity="0.15" />
      </linearGradient>
      <linearGradient id="toneSoft" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#2a2529" stop-opacity="0.3" />
        <stop offset="1" stop-color="#2a2529" stop-opacity="0.02" />
      </linearGradient>
      <filter id="soften" x="-25%" y="-25%" width="150%" height="150%">
        <feGaussianBlur stdDeviation="0.6" />
      </filter>

      <!-- ── Siamese cat, seated ─────────────────────────────────── -->
      <g id="cat-art">
        <!-- masses filled with the page colour so overlapping lines are hidden -->
        <g fill="#fdf8f8">
          <path d="M34 88c-9 0-15-9-13-20 2-13 10-23 22-27 9-3 18 0 22 8 5 10 4 24-3 32-6 7-18 8-28 7z" />
          <path d="M66 20c10 0 17 8 17 18 0 11-8 18-17 18s-17-7-17-18c0-10 7-18 17-18z" />
          <path d="M50 30c-1-8-2-14-1-16 2-1 8 4 13 9z" />
          <path d="M82 31c2-8 3-13 2-15-2-1-8 3-13 8z" />
        </g>

        <!-- dotwork: the points, heaviest on the mask and ears -->
        <path
          d="M66 27c9 0 15 7 15 15 0 9-7 15-15 15s-15-6-15-15c0-8 6-15 15-15z"
          fill="url(#toneMid)"
          filter="url(#soften)"
        />
        <path d="M50 30c-1-8-2-14-1-16 2-1 8 4 13 9z" fill="url(#toneDeep)" filter="url(#soften)" />
        <path d="M82 31c2-8 3-13 2-15-2-1-8 3-13 8z" fill="url(#toneDeep)" filter="url(#soften)" />
        <!-- haunch and chest tone -->
        <path
          d="M32 86c-7-3-10-12-8-22 2-11 8-19 17-23-8 8-12 18-12 27 0 7 1 13 3 18z"
          fill="url(#toneSoft)"
          filter="url(#soften)"
        />
        <path d="M40 88c-4 0-7-2-7-4s3-4 7-4 7 2 7 4-3 4-7 4z" fill="url(#toneMid)" filter="url(#soften)" />
        <path d="M56 88c-4 0-7-2-7-4s3-4 7-4 7 2 7 4-3 4-7 4z" fill="url(#toneMid)" filter="url(#soften)" />
        <!-- the tail, shaded rather than filled solid -->
        <path
          d="M26 86C12 86 6 74 12 66c4-6 12-6 15-1"
          fill="none"
          stroke="#1b1719"
          stroke-width="7.5"
          stroke-linecap="round"
          opacity="0.6"
        />

        <!-- ink linework -->
        <g fill="none" stroke="#1f1b1d" stroke-linecap="round" stroke-linejoin="round">
          <path
            d="M34 88c-9 0-15-9-13-20 2-13 10-23 22-27 9-3 18 0 22 8 5 10 4 24-3 32-6 7-18 8-28 7z"
            stroke-width="1.5"
          />
          <path
            d="M66 20c10 0 17 8 17 18 0 11-8 18-17 18s-17-7-17-18c0-10 7-18 17-18z"
            stroke-width="1.5"
          />
          <path d="M50 30c-1-8-2-14-1-16 2-1 8 4 13 9" stroke-width="1.4" />
          <path d="M82 31c2-8 3-13 2-15-2-1-8 3-13 8" stroke-width="1.4" />
          <path d="M26 86C12 86 6 74 12 66c4-6 12-6 15-1" stroke-width="1.4" />
          <!-- chest and haunch contours -->
          <path d="M52 84c-3-9-2-19 3-26" stroke-width="1" opacity="0.7" />
          <path d="M40 84c-4-3-6-11-4-19" stroke-width="0.9" opacity="0.55" />

          <!-- eyes -->
          <path d="M56 36c3-3 8-3 11 0-3 3-8 3-11 0z" stroke-width="1.2" />
          <path d="M74 36c3-3 8-3 11 0-3 3-8 3-11 0z" stroke-width="1.2" />
          <!-- brows -->
          <path d="M55 32c4-2 9-2 12 0" stroke-width="0.9" opacity="0.7" />
          <path d="M74 32c4-2 9-2 12 0" stroke-width="0.9" opacity="0.7" />
          <!-- muzzle and nose -->
          <path d="M66 45v4" stroke-width="1" />
          <path d="M62 51c2 2 6 2 8 0" stroke-width="1" />
          <path d="M63.6 44.4h4.8l-2.4 2.6z" stroke-width="1" fill="#1f1b1d" />
          <!-- whiskers -->
          <g stroke-width="0.8" opacity="0.75">
            <path d="M60 49c-7 0-12 2-16 5" />
            <path d="M61 52c-7 1-11 4-14 7" />
            <path d="M72 49c7 0 12 2 16 5" />
            <path d="M71 52c7 1 11 4 14 7" />
          </g>
        </g>

        <!-- pupils and catchlights sit above the linework -->
        <ellipse cx="61.5" cy="36" rx="1.7" ry="2.2" fill="#1b1719" />
        <ellipse cx="79.5" cy="36" rx="1.7" ry="2.2" fill="#1b1719" />
        <circle cx="60.7" cy="35.1" r="0.65" fill="#fdf8f8" />
        <circle cx="78.7" cy="35.1" r="0.65" fill="#fdf8f8" />
      </g>

      <!-- ── Dutch rabbit, side view ─────────────────────────────── -->
      <g id="rabbit-art">
        <g fill="#fdf8f8">
          <path d="M50 45c16-2 32 2 39 11 6 8 3 19-7 23-12 4-26 2-34-2-4-2-5-8-4-16 1-8 3-14 6-16z" />
          <path d="M27 59c0-9 6-16 14-16 8 0 13 6 13 15 0 9-6 15-14 15-8 0-13-5-13-14z" />
          <path d="M33 46c-4-11-5-21-2-25 3-3 7 4 9 14 1 6 2 11 2 14z" />
          <path d="M45 45c1-11 3-20 6-23 4-2 5 5 3 14-1 6-3 10-5 13z" />
        </g>

        <!-- dotwork: the Dutch saddle over the hindquarters -->
        <path
          d="M70 45c11 2 19 8 19 18 0 10-8 16-19 16-6 0-11-1-15-3 9-4 14-13 15-22 0-3 0-6 0-9z"
          fill="url(#toneDeep)"
          filter="url(#soften)"
        />
        <!-- the dark half of the head, blaze left as bare paper -->
        <path
          d="M36 45c6-3 13-2 17 3 3 5 3 12 0 17-4 5-11 6-16 3 4-4 6-11 6-16 0-3-3-5-7-7z"
          fill="url(#toneDeep)"
          filter="url(#soften)"
        />
        <!-- ears -->
        <path d="M33 46c-4-11-5-21-2-25 3-3 7 4 9 14 1 6 2 11 2 14z" fill="url(#toneMid)" filter="url(#soften)" />
        <path d="M45 45c1-11 3-20 6-23 4-2 5 5 3 14-1 6-3 10-5 13z" fill="url(#toneMid)" filter="url(#soften)" />
        <!-- belly and shoulder tone -->
        <path d="M50 70c10 5 22 6 32 2-9 6-24 6-32-2z" fill="url(#toneSoft)" filter="url(#soften)" />
        <path d="M46 50c3 6 4 14 2 21-1 4-3 7-5 9 5-9 6-21 3-30z" fill="url(#toneSoft)" filter="url(#soften)" />

        <!-- ink linework -->
        <g fill="none" stroke="#1f1b1d" stroke-linecap="round" stroke-linejoin="round">
          <path
            d="M50 45c16-2 32 2 39 11 6 8 3 19-7 23-12 4-26 2-34-2-4-2-5-8-4-16 1-8 3-14 6-16z"
            stroke-width="1.5"
          />
          <path
            d="M27 59c0-9 6-16 14-16 8 0 13 6 13 15 0 9-6 15-14 15-8 0-13-5-13-14z"
            stroke-width="1.5"
          />
          <path d="M33 46c-4-11-5-21-2-25 3-3 7 4 9 14 1 6 2 11 2 14" stroke-width="1.3" />
          <path d="M45 45c1-11 3-20 6-23 4-2 5 5 3 14-1 6-3 10-5 13" stroke-width="1.3" />
          <!-- inner ear lines -->
          <path d="M35 42c-3-8-3-14-2-16" stroke-width="0.8" opacity="0.6" />
          <path d="M47 41c1-7 2-12 4-14" stroke-width="0.8" opacity="0.6" />
          <!-- the saddle boundary, broken the way a tattoo fades out -->
          <path d="M68 46c2 6 2 13 0 20-2 7-6 13-11 16" stroke-width="1" opacity="0.5" />
          <!-- haunch and foot -->
          <path d="M36 75c5-2 11-2 15 1" stroke-width="1.1" />
          <circle cx="88" cy="66" r="6.5" stroke-width="1.2" />
          <!-- nose and whiskers -->
          <path d="M27.6 61.2h3.2l-1.6 1.9z" stroke-width="0.9" fill="#1f1b1d" />
          <g stroke-width="0.8" opacity="0.75">
            <path d="M26 64c-6 0-10 1-14 4" />
            <path d="M27 67c-5 1-9 3-12 6" />
          </g>
        </g>

        <!-- eye -->
        <circle cx="41" cy="55" r="3.6" fill="#fdf8f8" stroke="#1f1b1d" stroke-width="1.1" />
        <circle cx="41" cy="55" r="2.1" fill="#1b1719" />
        <circle cx="40.2" cy="54.2" r="0.8" fill="#fdf8f8" />
      </g>
    </defs>
  </svg>

  <div class="chase">
    <div class="runner runner-cat">
      <span class="gait">
        <svg viewBox="-14 -14 128 128" width="112" height="112" aria-hidden="true" focusable="false">
          <use href="#cat-art" filter="url(#tattoo)"></use>
        </svg>
      </span>
    </div>

    <div class="runner runner-rabbit">
      <span class="gait">
        <svg viewBox="-14 -14 128 128" width="112" height="112" aria-hidden="true" focusable="false">
          <use href="#rabbit-art" filter="url(#tattoo)"></use>
        </svg>
      </span>
    </div>
  </div>

  <p class="loader-note">just a moment</p>
</div>

<script is:inline>
  (function () {
    var el = document.getElementById('site-loader');
    if (!el) return;
    try {
      sessionStorage.setItem('sm-loader-seen', '1');
    } catch (e) {
      /* private mode: the loader simply shows again next time */
    }
    window.setTimeout(function () {
      el.remove();
    }, 2000);
  })();
</script>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    background: var(--color-bg);
    /* dismisses on its own, with or without JavaScript */
    animation: loader-out 1.5s ease-in 1.05s forwards;
  }

  .loader-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* A straight run across the frame: the cat leads, the rabbit gives chase.
     Travel is linear so the pace stays even; the bounce lives separately in
     the gait, which keeps the motion fluid rather than mechanical. */
  .chase {
    --track: 360px;
    position: relative;
    width: var(--track);
    height: 150px;
    overflow: hidden;
  }

  .runner {
    position: absolute;
    bottom: 8px;
    left: 0;
    animation: run 2.9s linear infinite;
    /* both start part-way along, so the pair is already on screen at load
       rather than the rabbit trailing in from off-frame */
    animation-delay: -0.62s;
  }

  /* a further head start, so the rabbit is always trailing */
  .runner-cat {
    animation-delay: -1.04s;
  }

  .gait {
    display: block;
    animation: pad 0.66s ease-in-out infinite alternate;
  }

  /* the rabbit hops: shorter cycle, higher arc */
  .runner-rabbit .gait {
    animation: hop 0.44s cubic-bezier(0.33, 0, 0.5, 1) infinite alternate;
  }

  .runner-rabbit .gait svg {
    transform: scaleX(-1);
  }

  @keyframes run {
    from {
      transform: translateX(-140px);
    }
    to {
      transform: translateX(calc(var(--track) + 140px));
    }
  }

  @keyframes pad {
    from {
      transform: translateY(1px);
    }
    to {
      transform: translateY(-4px);
    }
  }

  @keyframes hop {
    from {
      transform: translateY(4px) rotate(-1.5deg);
    }
    to {
      transform: translateY(-10px) rotate(2deg);
    }
  }

  @media (max-width: 760px) {
    .chase {
      --track: 250px;
      height: 130px;
    }

    .runner svg {
      width: 92px;
      height: 92px;
    }
  }

  .loader-note {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1.35rem;
    color: var(--color-text-muted);
  }

  @keyframes loader-out {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  /* Returning within the same tab session, or preferring less motion:
     skip the animation entirely. */
  :global(html.loader-seen) .loader {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .loader {
      display: none;
    }
  }
</style>
