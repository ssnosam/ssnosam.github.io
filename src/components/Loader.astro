---
/**
 * Brief page-load animation: a line-drawn cat and rabbit watching a loading
 * bar fill. Clean 2D linework, no filters or gradients — at this size flat
 * line art stays legible where rendered shading turns to mush.
 *
 * It dismisses itself in CSS, so a JS failure can never leave a visitor
 * staring at a covered page.
 */
---

<div class="loader" id="site-loader" aria-hidden="true">
  <svg
    class="scene"
    viewBox="0 0 320 132"
    width="320"
    height="132"
    fill="none"
    stroke="#2b2226"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <!-- a plain rect does the wiping, so the fill keeps its round ends -->
      <clipPath id="barClip">
        <rect class="clip-rect" x="112" y="66" width="96" height="18" />
      </clipPath>
    </defs>

    <!-- ── cat, sitting at the left, watching the bar ── -->
    <g class="cat">
      <!-- tail, hinged at the body -->
      <path class="tail" d="M78 92c14 2 20-6 17-16" />
      <!-- body -->
      <path d="M44 94c-2-14 6-24 18-24s20 10 18 24z" fill="#fdf8f8" />
      <!-- front paws -->
      <path d="M54 94v-5M70 94v-5" stroke-width="2.4" />
      <!-- ears first, so the head's fill hides where they join -->
      <path d="M49 40l-3-14 15 8M75 40l3-14-15 8" fill="#fdf8f8" />
      <!-- head -->
      <circle cx="62" cy="52" r="18" fill="#fdf8f8" />
      <!-- face -->
      <g class="blink">
        <path d="M55 50v3M69 50v3" stroke-width="2.6" />
      </g>
      <path d="M60.5 58h3l-1.5 2z" fill="#2b2226" stroke-width="1.6" />
      <path d="M62 61c-2 2-5 1-5-1M62 61c2 2 5 1 5-1" stroke-width="1.8" />
      <!-- whiskers -->
      <g stroke-width="1.6">
        <path d="M50 58l-11-3M50 62l-11 2M74 58l11-3M74 62l11 2" />
      </g>
    </g>

    <!-- ── loading bar ── -->
    <rect x="112" y="66" width="96" height="18" rx="9" fill="#fdf8f8" />
    <rect
      class="bar-fill"
      x="112"
      y="66"
      width="96"
      height="18"
      rx="9"
      fill="#e7c3d2"
      stroke="none"
      clip-path="url(#barClip)"
    />
    <rect x="112" y="66" width="96" height="18" rx="9" />

    <!-- ── rabbit, sitting at the right, watching too ── -->
    <g class="rabbit">
      <!-- ears -->
      <g class="ears">
        <path d="M248 44c-4-13-4-24-1-26s7 8 8 20" fill="#fdf8f8" />
        <path d="M262 42c2-13 5-23 8-24s3 10-1 21" fill="#fdf8f8" />
      </g>
      <!-- body -->
      <path d="M232 94c-2-15 8-26 22-26s24 11 22 26z" fill="#fdf8f8" />
      <!-- cotton tail -->
      <circle cx="279" cy="82" r="7" fill="#fdf8f8" />
      <!-- head -->
      <circle cx="250" cy="58" r="15" fill="#fdf8f8" />
      <!-- face -->
      <path d="M244 56v3" stroke-width="2.6" />
      <path d="M238.5 62h3l-1.5 2z" fill="#2b2226" stroke-width="1.6" />
      <g stroke-width="1.6">
        <path d="M236 64l-10-2M236 67l-9 3" />
      </g>
      <!-- front paws -->
      <path d="M244 94v-5M258 94v-5" stroke-width="2.4" />
    </g>

    <!-- ground line -->
    <path d="M28 94h264" stroke-width="2.4" opacity="0.35" />
  </svg>

  <p class="loader-note">just a moment</p>
</div>

<script is:inline>
  (function () {
    var el = document.getElementById('site-loader');
    if (!el) return;
    try {
      sessionStorage.setItem('sm-loader-seen', '1');
    } catch (e) {
      /* private mode: the loader simply shows again next time */
    }
    window.setTimeout(function () {
      el.remove();
    }, 2000);
  })();
</script>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    background: var(--color-bg);
    /* dismisses on its own, with or without JavaScript */
    animation: loader-out 1.5s ease-in 1.05s forwards;
  }

  .scene {
    width: min(320px, 82vw);
    height: auto;
  }

  /* the bar wipes left to right, then holds full for a beat */
  .clip-rect {
    transform-box: fill-box;
    transform-origin: left center;
    animation: fill 1.9s cubic-bezier(0.45, 0, 0.25, 1) infinite;
  }

  /* tail wag */
  .tail {
    transform-box: fill-box;
    transform-origin: 0% 100%;
    animation: wag 0.62s ease-in-out infinite alternate;
  }

  /* a slow blink, and the rabbit's ears twitch on a different beat */
  .blink {
    transform-box: fill-box;
    transform-origin: center;
    animation: blink 2.4s steps(1, end) infinite;
  }

  .ears {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: twitch 1.7s ease-in-out infinite;
  }

  @keyframes fill {
    0% {
      transform: scaleX(0);
    }
    72% {
      transform: scaleX(1);
    }
    100% {
      transform: scaleX(1);
    }
  }

  @keyframes wag {
    from {
      transform: rotate(-10deg);
    }
    to {
      transform: rotate(16deg);
    }
  }

  @keyframes blink {
    0%,
    92%,
    100% {
      transform: scaleY(1);
    }
    94%,
    98% {
      transform: scaleY(0.15);
    }
  }

  @keyframes twitch {
    0%,
    70%,
    100% {
      transform: rotate(0deg);
    }
    78% {
      transform: rotate(-4deg);
    }
    86% {
      transform: rotate(2.5deg);
    }
  }

  .loader-note {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1.3rem;
    color: var(--color-text-muted);
  }

  @keyframes loader-out {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  /* Returning within the same tab session, or preferring less motion:
     skip the animation entirely. */
  :global(html.loader-seen) .loader {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .loader {
      display: none;
    }
  }
</style>
