---
/* A persona's journey as columns of steps, each with the touchpoints it
   crosses and the opportunity it opened. Columns share rows through subgrid,
   so steps, chips, and opportunities line up across the map. */
interface Props {
  steps: { step: string; touchpoints: string[]; opportunity?: string }[];
  label?: string;
  class?: string;
}

const { steps, label = 'User journey', class: className = '' } = Astro.props;
---

<figure class:list={['lanes', className]} aria-label={label} style={`--cols: ${steps.length}`}>
  <div class="row-labels" aria-hidden="true">
    <span>Doing</span>
    <span>Touchpoints</span>
    <span>Opportunity</span>
  </div>
  <ol class="columns">
    {
      steps.map((s, i) => (
        <li class="col">
          <p class="step">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            {s.step}
          </p>
          <ul class="chips" aria-label="Touchpoints">
            {s.touchpoints.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
          {s.opportunity ? (
            <p class="opportunity">
              <span class="inline-label">Opportunity</span>
              {s.opportunity}
            </p>
          ) : (
            <span />
          )}
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .lanes {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    grid-template-rows: auto auto auto;
    column-gap: var(--space-4);
    margin: 0;
  }

  .row-labels {
    display: grid;
    grid-row: 1 / 4;
    grid-template-rows: subgrid;
    row-gap: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .row-labels span {
    padding-top: var(--space-3);
  }

  .columns {
    display: grid;
    grid-row: 1 / 4;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    grid-template-rows: subgrid;
    column-gap: var(--space-3);
    row-gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .col {
    display: grid;
    grid-row: 1 / 4;
    grid-template-rows: subgrid;
    row-gap: var(--space-4);
  }

  .step {
    margin: 0;
    padding: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-text);
  }

  .num {
    display: block;
    margin-bottom: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    color: var(--color-accent-soft);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-2) 0 0;
    list-style: none;
  }

  .chips li {
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--meadow-mint-wash, var(--color-accent-wash));
    font-size: var(--text-xs);
    color: var(--color-accent-ink);
  }

  .opportunity {
    align-self: start;
    margin: 0;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--meadow-sun-wash, var(--color-note));
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-text);
  }

  .inline-label {
    display: none;
  }

  @media (max-width: 900px) {
    .lanes {
      display: block;
    }

    .row-labels {
      display: none;
    }

    .columns {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      row-gap: var(--space-5);
    }

    .col {
      grid-row: auto;
      grid-template-rows: none;
      row-gap: var(--space-3);
    }

    .chips {
      padding: 0;
    }

    .inline-label {
      display: block;
      margin-bottom: var(--space-1);
      font-size: var(--text-xs);
      font-weight: 600;
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--color-text-muted);
    }
  }
</style>
