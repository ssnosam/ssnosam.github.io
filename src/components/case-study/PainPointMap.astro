---
/* Pain points laid along the lifecycle they occur in, with the stage the
   project took on lifted out of the list. */
interface Props {
  points: { stage: string; pain: string; focus?: boolean }[];
  focusLabel?: string;
  class?: string;
}

const { points, focusLabel = 'Our focus', class: className = '' } = Astro.props;
---

<ol class:list={['lifecycle', className]}>
  {
    points.map((p, i) => (
      <li class:list={['stage', { 'is-focus': p.focus }]}>
        <span class="dot" aria-hidden="true">
          {i + 1}
        </span>
        <div class="copy">
          <p class="name">
            {p.stage}
            {p.focus && <span class="tag">{focusLabel}</span>}
          </p>
          <p class="pain">“{p.pain}”</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .lifecycle {
    position: relative;
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The rail runs behind the dots, so the list reads as one path. */
  .lifecycle::before {
    content: '';
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    left: calc(var(--space-3) + 0.8125rem);
    width: 1px;
    background: var(--color-border);
  }

  .stage {
    position: relative;
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
  }

  .dot {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    transform: translateY(0.3rem);
  }

  .copy {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-3);
    align-items: baseline;
  }

  .name,
  .pain {
    margin: 0;
  }

  .name {
    font-weight: 600;
    color: var(--color-text);
  }

  .pain {
    color: var(--color-text-muted);
  }

  .is-focus {
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    background: var(--color-accent-wash);
    box-shadow: inset 0 0 0 1px var(--color-highlight);
  }

  .is-focus .dot {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .is-focus .pain {
    color: var(--color-text);
  }

  .tag {
    margin-left: var(--space-2);
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent-ink);
    white-space: nowrap;
  }
</style>
