---
/* One design decision, told the way the deck tells it: the tension, the call,
   and what it cost. The visual goes in the slot and sits beside the copy;
   `flip` puts it on the right so a run of decisions alternates. */
interface Props {
  eyebrow: string;
  title: string;
  tension: string;
  call: string | string[];
  cost: string;
  caption?: string;
  flip?: boolean;
  index?: number;
  class?: string;
}

const {
  eyebrow,
  title,
  tension,
  call,
  cost,
  caption,
  flip = false,
  index = 0,
  class: className = '',
} = Astro.props;
const hasVisual = Astro.slots.has('default');
---

<article
  class:list={['decision', 'reveal', { flip, 'no-visual': !hasVisual }, className]}
  style={`--reveal-delay: ${index * 0.06}s`}
>
  <div class="copy">
    <p class="eyebrow kicker">{eyebrow}</p>
    <h3>{title}</h3>
    <dl>
      <dt>The tension</dt>
      <dd>{tension}</dd>
      <dt class="call">The call</dt>
      <dd class="call">
        {Array.isArray(call) ? <ul>{call.map((c) => <li>{c}</li>)}</ul> : call}
      </dd>
      <dt>The cost</dt>
      <dd class="cost">{cost}</dd>
    </dl>
  </div>
  {
    hasVisual && (
      <figure class="visual">
        <slot />
        {caption && <figcaption>{caption}</figcaption>}
      </figure>
    )
  }
</article>

<style>
  .decision {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    column-gap: var(--space-6);
    align-items: start;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .decision + .decision {
    margin-top: var(--space-7);
  }

  .flip {
    grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
  }

  .flip .copy {
    order: 2;
  }

  .no-visual {
    grid-template-columns: minmax(0, var(--measure));
  }

  .kicker {
    margin-bottom: var(--space-2);
    color: var(--color-accent);
  }

  h3 {
    margin-bottom: var(--space-4);
  }

  dl {
    margin: 0;
  }

  dt {
    margin-bottom: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  dd {
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-muted);
  }

  /* The call is the decision itself, so it reads loudest. */
  dt.call {
    color: var(--color-accent);
  }

  dd.call {
    color: var(--color-text);
  }

  dd ul {
    margin: 0;
    padding-left: 1.1em;
  }

  dd li + li {
    margin-top: var(--space-1);
  }

  dd.cost {
    margin-bottom: 0;
    padding: var(--space-3) var(--space-4);
    background: var(--color-accent-wash);
    border-radius: var(--radius-md);
    color: var(--color-text);
  }

  .visual {
    margin: 0;
    min-width: 0;
  }

  figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    line-height: var(--leading-body);
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .decision,
    .flip {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-5);
    }

    .flip .copy {
      order: 0;
    }
  }
</style>
