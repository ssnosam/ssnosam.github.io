---
interface Props {
  items: { label: string; lines: (string | { text: string; href: string })[] }[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<dl class:list={['meta', className]}>
  {
    items.map((item, i) => (
      <div class="meta-item reveal" style={`--reveal-delay: ${i * 0.08}s`}>
        <dt class="meta-label">{item.label}</dt>
        {item.lines.map((line) =>
          typeof line === 'string' ? (
            <dd class="meta-line">{line}</dd>
          ) : (
            <dd class="meta-line">
              <a href={line.href} target="_blank" rel="noopener noreferrer">
                {line.text}
              </a>
            </dd>
          )
        )}
      </div>
    ))
  }
</dl>

<style>
  .meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
    margin: 0;
  }

  /* Matches the resume's section labels: the site's one uppercase treatment. */
  .meta-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-accent);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .meta-line {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .meta-line:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 560px) {
    .meta {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
