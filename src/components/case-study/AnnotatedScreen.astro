---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /* Pins are percentages of the image box, so they stay put at any size. A
     callout can point at several places at once (say, three metrics in a row). */
  callouts: { text: string; pins: [number, number][] }[];
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  callouts,
  sizes = '(max-width: 900px) 92vw, 42rem',
  class: className = '',
} = Astro.props;

const widths = [640, 960, 1280, 1600].filter((w) => w < src.width).concat(src.width);
---

<figure class:list={['annotated', className]}>
  <div class="shot">
    <Image src={src} alt={alt} widths={widths} sizes={sizes} loading="lazy" decoding="async" />
    {
      callouts.map((callout, i) =>
        callout.pins.map(([x, y]) => (
          <span class="pin" style={`left: ${x}%; top: ${y}%`} aria-hidden="true">
            {i + 1}
          </span>
        ))
      )
    }
  </div>

  <figcaption>
    <ol class="callouts">
      {
        callouts.map((callout, i) => (
          <li>
            <span class="num" aria-hidden="true">
              {i + 1}
            </span>
            <span>{callout.text}</span>
          </li>
        ))
      }
    </ol>
  </figcaption>
</figure>

<style>
  .annotated {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    column-gap: var(--space-6);
    align-items: center;
    margin: 0;
  }

  .shot {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 18px 40px -24px rgba(31, 42, 54, 0.25);
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  .pin,
  .num {
    display: inline-grid;
    place-items: center;
    width: 1.625rem;
    height: 1.625rem;
    flex: none;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
  }

  .pin {
    position: absolute;
    transform: translate(-50%, -50%);
    box-shadow:
      0 0 0 3px rgba(255, 255, 255, 0.95),
      0 4px 10px rgba(31, 42, 54, 0.2);
  }

  .callouts {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .callouts li {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-muted);
  }

  .num {
    transform: translateY(0.35rem);
    background: var(--color-accent-wash);
    color: var(--color-accent-ink);
  }

  @media (max-width: 900px) {
    .annotated {
      grid-template-columns: 1fr;
      row-gap: var(--space-5);
    }
  }

  @media (max-width: 560px) {
    .pin {
      width: 1.25rem;
      height: 1.25rem;
      font-size: 0.6875rem;
    }
  }
</style>
