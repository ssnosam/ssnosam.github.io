---
import { render } from 'astro:content';

interface Props {
  entry: any;
}

const { entry } = Astro.props;
const { company, role, startDate, endDate, note } = entry.data;
const { Content } = await render(entry);

// an open end date means this is the role Shelby holds today
const isCurrent = endDate === null;

function formatDate(date: Date | null) {
  if (!date) return 'Present';
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
}
---

<article class={`timeline-item ${isCurrent ? 'is-current' : ''}`}>
  <p class="dates">{formatDate(startDate)} – {formatDate(endDate)}</p>
  <div class="timeline-marker" aria-hidden="true"></div>
  <div class="timeline-body">
    <div class="company-line">
      <h3>{company}</h3>
      {isCurrent && <span class="current-badge">Current</span>}
    </div>
    <p class="role">{role}</p>
    {note && <p class="note">{note}</p>}
    <div class="prose">
      <Content />
    </div>
  </div>
</article>

<style>
  /* dates | marker rail | body */
  .timeline-item {
    --dates-col: 9.5rem;
    --rail-gap: var(--space-4);
    display: grid;
    grid-template-columns: var(--dates-col) 1.25rem 1fr;
    column-gap: var(--rail-gap);
    padding-bottom: var(--space-6);
    position: relative;
  }

  .timeline-item:not(:last-child)::before {
    content: '';
    position: absolute;
    /* centre the rail under the marker, past the dates column */
    left: calc(var(--dates-col) + var(--rail-gap) + 0.5625rem);
    top: 1.5rem;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }

  .timeline-marker {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--color-accent);
    margin-top: 0.2rem;
  }

  /* the role Shelby holds now: a halo on the marker and a small badge */
  .is-current .timeline-marker {
    box-shadow: 0 0 0 5px var(--color-accent-wash);
  }

  .company-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .current-badge {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-accent-ink);
    background: var(--color-accent-wash);
    border: 1px solid var(--color-highlight);
    border-radius: var(--radius-pill);
    padding: 0.15rem 0.6rem;
    white-space: nowrap;
  }

  .is-current .company-line h3 {
    font-weight: 500;
  }

  .company-line h3 {
    margin: 0;
    font-size: 1.2rem;
  }

  .dates {
    grid-column: 1;
    margin: 0;
    padding-top: 0.15rem;
    text-align: right;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .role {
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .note {
    font-style: italic;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .timeline-body :global(p) {
    margin-bottom: var(--space-2);
  }

  .timeline-body :global(ul) {
    margin: var(--space-3) 0 var(--space-2);
    padding-left: var(--space-4);
  }

  /* generous gaps between bullets so the list is easy to scan */
  .timeline-body :global(li) {
    margin-bottom: var(--space-3);
    padding-left: var(--space-1);
    line-height: 1.6;
  }

  .timeline-body :global(li:last-child) {
    margin-bottom: 0;
  }

  .timeline-body :global(li)::marker {
    color: var(--color-accent);
  }

  /* too narrow for a dates column on a phone: stack the date above the role */
  @media (max-width: 640px) {
    .timeline-item {
      grid-template-columns: 1.25rem 1fr;
    }

    .timeline-item:not(:last-child)::before {
      left: 0.5625rem;
    }

    .timeline-marker {
      grid-column: 1;
      grid-row: 1;
    }

    .dates {
      grid-column: 2;
      grid-row: 1;
      text-align: left;
      padding-top: 0.15rem;
      margin-bottom: var(--space-1);
    }

    .timeline-body {
      grid-column: 2;
      grid-row: 2;
    }
  }
</style>
