---
import { render } from 'astro:content';

interface Props {
  entry: any;
}

const { entry } = Astro.props;
const { company, role, startDate, endDate, note } = entry.data;
const { Content } = await render(entry);

function formatDate(date: Date | null) {
  if (!date) return 'Present';
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
}
---

<article class="timeline-item">
  <div class="timeline-marker" aria-hidden="true"></div>
  <div class="timeline-body">
    <div class="timeline-header">
      <h3>{company}</h3>
      <span class="dates">{formatDate(startDate)} – {formatDate(endDate)}</span>
    </div>
    <p class="role">{role}</p>
    {note && <p class="note">{note}</p>}
    <div class="prose">
      <Content />
    </div>
  </div>
</article>

<style>
  .timeline-item {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    position: relative;
  }

  .timeline-item:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 0.5625rem;
    top: 1.5rem;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }

  .timeline-marker {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--color-accent);
    margin-top: 0.2rem;
  }

  .timeline-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .timeline-header h3 {
    margin: 0;
    font-size: 1.2rem;
  }

  .dates {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .role {
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .note {
    font-style: italic;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .timeline-body :global(p) {
    margin-bottom: var(--space-2);
  }

  .timeline-body :global(ul) {
    margin: var(--space-3) 0 var(--space-2);
    padding-left: var(--space-4);
  }

  /* generous gaps between bullets so the list is easy to scan */
  .timeline-body :global(li) {
    margin-bottom: var(--space-3);
    padding-left: var(--space-1);
    line-height: 1.6;
  }

  .timeline-body :global(li:last-child) {
    margin-bottom: 0;
  }

  .timeline-body :global(li)::marker {
    color: var(--color-accent);
  }
</style>
