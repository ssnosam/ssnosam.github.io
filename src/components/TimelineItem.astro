---
import { render } from 'astro:content';

interface Props {
  item: {
    entry: any;
    title: string;
    role: string;
    startDate: Date;
    endDate: Date | null;
    note?: string;
    summary?: string;
    kind: 'work' | 'volunteer';
  };
  index?: number;
}

const { item, index = 0 } = Astro.props;
const { entry, title, role, startDate, endDate, note, summary } = item;
const { Content } = await render(entry);

const detailsId = `details-${entry.id.replace(/[^a-z0-9]+/gi, '-')}`;

// an open end date means this is a role Shelby holds today
const isCurrent = endDate === null;

function formatDate(date: Date | null) {
  if (!date) return 'Present';
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
}
---

<article
  class={`timeline-item reveal ${isCurrent ? 'is-current' : ''}`}
  style={`--reveal-delay: ${index * 0.08}s`}
>
  <p class="dates">
    <span>{formatDate(startDate)}</span> <span>&ndash; {formatDate(endDate)}</span>
  </p>
  <div class="timeline-marker" aria-hidden="true"></div>
  <div class="timeline-body">
    <div class="company-line">
      <h3>{title}</h3>
      {isCurrent && <span class="current-badge">Current</span>}
    </div>
    <p class="role">{role}</p>
    {note && <p class="note">{note}</p>}
    {summary && <p class="summary">{summary}</p>}
    <button class="details-toggle" type="button" aria-expanded="false" aria-controls={detailsId}>
      <span class="details-sign" aria-hidden="true">+</span> Read more
    </button>
    <div class="details" id={detailsId}>
      <div class="details-inner">
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  /* dates | marker rail | body */
  .timeline-item {
    --dates-col: var(--timeline-dates-col, 9.5rem);
    --rail-gap: var(--timeline-rail-gap, var(--space-4));
    display: grid;
    grid-template-columns: var(--dates-col) 1.25rem 1fr;
    column-gap: var(--rail-gap);
    padding-bottom: var(--space-6);
    position: relative;
  }

  .timeline-item:not(:last-child)::before {
    content: '';
    position: absolute;
    /* centre the rail under the marker, past the dates column */
    left: calc(var(--dates-col) + var(--rail-gap) + 0.5625rem);
    /* starts at the dot centre so it meets both sizes; the marker sits above
       it, so the run behind the dot never shows */
    top: 0.8rem;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }

  /* Past roles get a small, soft dot: at full size and full accent they
     pulled more attention than the entries themselves. Centred in the
     marker column so it still sits on the rail. */
  .timeline-marker {
    /* the rail is absolutely positioned, so without a stacking bump it paints
       over the dot and shows through as a line across it */
    position: relative;
    z-index: 1;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--color-highlight);
    border: 1px solid var(--color-accent-soft);
    justify-self: center;
    margin-top: 0.5rem;
  }

  /* the role Shelby holds now: full size, solid, and haloed */
  .is-current .timeline-marker {
    width: 1.25rem;
    height: 1.25rem;
    background: var(--color-accent);
    border: none;
    margin-top: 0.2rem;
    box-shadow: 0 0 0 5px var(--color-accent-wash);
  }

  .company-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .current-badge {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-accent-ink);
    background: var(--color-accent-wash);
    border: 1px solid var(--color-highlight);
    border-radius: var(--radius-pill);
    padding: 0.15rem 0.6rem;
    white-space: nowrap;
  }

  .is-current .company-line h3 {
    font-weight: 500;
  }

  .company-line h3 {
    margin: 0;
    font-size: var(--text-h3);
  }

  .dates {
    grid-column: 1;
    margin: 0;
    padding-top: 0.15rem;
    text-align: right;
    font-size: var(--text-xs);
    line-height: var(--leading-body);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* In the narrow two-column gutter the stamp has to wrap. Keeping each date
     whole means it breaks between them rather than stranding a month. */
  .dates span {
    white-space: nowrap;
  }

  .summary {
    margin-bottom: var(--space-2);
  }

  .details-toggle {
    display: inline-block;
    padding: var(--space-1) 0;
    margin-bottom: var(--space-1);
    background: none;
    border: none;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    cursor: pointer;
  }

  .details-toggle:hover {
    color: var(--color-accent-ink);
  }

  .details-sign {
    display: inline-block;
    width: 0.75em;
  }

  /* 0fr to 1fr animates to the content's own height, so nothing has to be
     measured in script and a resize can't leave the panel clipped. */
  .details {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .details.is-open {
    grid-template-rows: 1fr;
  }

  .details-inner {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .details {
      transition: none;
    }
  }

  /* nothing collapses on paper */
  @media print {
    .details {
      grid-template-rows: 1fr;
    }

    .details-toggle {
      display: none;
    }
  }

  .role {
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .note {
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .timeline-body :global(p) {
    margin-bottom: var(--space-2);
  }

  .timeline-body :global(ul) {
    margin: var(--space-3) 0 var(--space-2);
    padding-left: var(--space-4);
  }

  /* generous gaps between bullets so the list is easy to scan */
  .timeline-body :global(li) {
    margin-bottom: var(--space-3);
    padding-left: var(--space-1);
    line-height: var(--leading-body);
  }

  .timeline-body :global(li:last-child) {
    margin-bottom: 0;
  }

  .timeline-body :global(li)::marker {
    color: var(--color-accent);
  }

  /* too narrow for a dates column on a phone: stack the date above the role */
  @media (max-width: 640px) {
    .timeline-item {
      grid-template-columns: 1.25rem 1fr;
    }

    .timeline-item:not(:last-child)::before {
      left: 0.5625rem;
    }

    .timeline-marker {
      grid-column: 1;
      grid-row: 1;
    }

    .dates {
      grid-column: 2;
      grid-row: 1;
      text-align: left;
      padding-top: 0.15rem;
      margin-bottom: var(--space-1);
    }

    .timeline-body {
      grid-column: 2;
      grid-row: 2;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.details-toggle').forEach((btn) => {
    const panel = document.getElementById(btn.getAttribute('aria-controls') as string);
    if (!panel) return;

    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      panel.classList.toggle('is-open', !open);
      btn.innerHTML = open
        ? '<span class="details-sign" aria-hidden="true">+</span> Read more'
        : '<span class="details-sign" aria-hidden="true">\u2013</span> Less';
    });
  });
</script>
