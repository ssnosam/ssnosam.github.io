---
import { site } from '../data/site.config';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-bottom">
    <p class="made-with">Made with love <span aria-hidden="true">🌸</span></p>
    <p class="copyright">&copy; {year} {site.name}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-6) 0;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  /* signed off in the same hand as the sticky note; Cedarville's small
     x-height and fine strokes need extra size to hold up at footer scale */
  .made-with {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1.3rem;
    line-height: 1.4;
    color: var(--color-ink);
  }

  .copyright {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>
