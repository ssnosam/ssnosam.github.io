---
import { site } from '../data/site.config';

const links = [
  { label: 'About', href: '#about' },
  { label: 'Philosophy', href: '#philosophy' },
  { label: 'Experience', href: '#experience' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-name">{site.name}</a>
    <nav>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li>
          <a href="/resume" class="resume-link">Résumé</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    /* match the sheet's rounded top so the bar doesn't square off its corners */
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
  }

  .nav-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-text);
  }

  .nav-name:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--color-text-muted);
    font-weight: 500;
    font-size: var(--text-sm);
  }

  nav a:hover {
    color: var(--color-accent);
  }

  .resume-link {
    color: var(--color-accent);
  }

  /* On phones the five links plus the name can't share one row, so the bar
     stacks and the links wrap. Two stacked rows are too tall to pin to the
     top of a phone screen, so the bar scrolls away here instead of sticking,
     leaving the full viewport for reading. */
  @media (max-width: 760px) {
    .nav {
      position: static;
    }

    .nav-inner {
      flex-direction: column;
      align-items: center;
      gap: var(--space-1);
      padding-top: var(--space-2);
      padding-bottom: var(--space-2);
    }

    nav ul {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0 var(--space-4);
    }

    nav a {
      display: inline-block;
      padding: var(--space-2) 0;
      font-size: var(--text-sm);
    }
  }
</style>
