---
import { site, skills, tools, education, quickFacts } from '../data/site.config';
import ResumeCTA from './ResumeCTA.astro';
import StickyNote from './StickyNote.astro';
import Polaroid from './Polaroid.astro';
---

<section id="about">
  <div class="container about-grid">
    <div class="prose">
      <h2 class="reveal">About me</h2>

      <ul class="quick-facts reveal" style="--reveal-delay: 0.08s">
        {
          quickFacts.map((fact) => (
            <li>
              <span class="fact-emoji" aria-hidden="true">
                {fact.emoji}
              </span>
              <span set:html={fact.text} />
            </li>
          ))
        }
      </ul>

      <p class="tilde reveal" style="--reveal-delay: 0.14s" aria-hidden="true">~</p>

      {site.bio.map((paragraph, i) => (
        <p class="reveal" style={`--reveal-delay: ${0.2 + i * 0.08}s`}>
          {paragraph}
        </p>
      ))}
      <div class="reveal" style="--reveal-delay: 0.36s">
        <ResumeCTA />
      </div>
    </div>

    <div class="about-media reveal" style="--reveal-delay: 0.12s">
      <Polaroid
        src="/shelby.jpg"
        alt="Shelby Mason bundled up in a winter coat, with a city skyline behind her"
        rotate={-3}
      />
      <StickyNote rotate={5} class="about-note">Hi there, I'm Shelby :)</StickyNote>
    </div>

    <div class="about-lists reveal" style="--reveal-delay: 0.2s">
        <div>
          <h3>Expertise</h3>
          <ul>
            {skills.map((skill) => <li>{skill}</li>)}
          </ul>
        </div>
        <div>
          <h3>Familiar tools</h3>
          <ul>
            {tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </div>
        <div>
          <h3>Education</h3>
          <ul class="education-list">
            {
              education.map((item) => (
                <li>
                  <strong>{item.school}</strong>
                  <span>{item.program}</span>
                  <span class="detail">{item.detail}</span>
                </li>
              ))
            }
          </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Three siblings placed explicitly, so the photo can move above the copy
     on narrow screens without disturbing the two-column desktop layout.
     The photo and lists share the narrow left column; the copy runs down
     the wide right one and keeps the same 3fr it had before the swap, so
     the reading measure is unchanged. */
  .about-grid {
    display: grid;
    grid-template-columns: 2fr 3fr;
    column-gap: var(--space-7);
    row-gap: var(--space-6);
    align-items: start;
  }

  .about-media {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
  }

  .about-lists {
    grid-column: 1;
    grid-row: 2;
  }

  .prose {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .quick-facts {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
  }

  .quick-facts li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
  }

  .fact-emoji {
    flex: none;
    width: 1.4em;
    text-align: center;
  }

  .quick-facts :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .tilde {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1;
    color: var(--color-accent-soft);
    margin: var(--space-4) 0 var(--space-3);
  }

  /* the note overlaps the photo's lower corner, like it was stuck on after */
  .about-media {
    position: relative;
    width: fit-content;
    margin-right: var(--space-5);
    padding-bottom: var(--space-5);
  }

  .about-media :global(.about-note) {
    position: absolute;
    right: -4.75rem;
    bottom: -2.25rem;
    z-index: 2;
    width: 12rem;
    min-height: 9.5rem;
  }

  .about-lists {
    width: 100%;
  }

  .about-lists h3 {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .about-lists > div {
    margin-bottom: var(--space-5);
  }

  .about-lists ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .about-lists li {
    /* a touch of warmth so the chips separate from the white sheet */
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
  }

  .education-list li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    background: none;
    border: none;
    padding: 0;
  }

  .education-list li {
    font-size: var(--text-sm);
  }

  .education-list .detail {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  @media (max-width: 800px) {
    .about-grid {
      grid-template-columns: 1fr;
      row-gap: var(--space-5);
    }

    /* photo and note lead, then the copy, then the lists */
    .about-media {
      grid-column: 1;
      grid-row: 1;
      justify-self: center;
      margin: 0 auto var(--space-2);
    }

    .prose {
      grid-column: 1;
      grid-row: 2;
    }

    .about-lists {
      grid-column: 1;
      grid-row: 3;
    }

    /* the note's overhang runs off a phone screen, so tuck it in closer */
    .about-media :global(.about-note) {
      right: -1rem;
      bottom: -1.5rem;
    }
  }
</style>
