---
import { site, skills, tools, education, quickFacts } from '../data/site.config';
import ResumeCTA from './ResumeCTA.astro';
import StickyNote from './StickyNote.astro';
import Polaroid from './Polaroid.astro';
---

<section id="about">
  <div class="container about-grid">
    <div class="prose">
      <h2><span class="highlight">About me</span></h2>
      <p class="tagline">{site.tagline}</p>

      <ul class="quick-facts">
        {
          quickFacts.map((fact) => (
            <li>
              <span class="fact-emoji" aria-hidden="true">
                {fact.emoji}
              </span>
              <span set:html={fact.text} />
            </li>
          ))
        }
      </ul>

      <p class="tilde" aria-hidden="true">~</p>

      <p>{site.description}</p>
      <p>
        I have 8 years of experience in user research and software product development, with an
        emphasis on data and sustainability initiatives. I like bringing concepts to life for
        start-ups and larger organizations alike, always grounded in human-centered design.
      </p>
      <ResumeCTA />
    </div>

    <div class="about-side">
      <div class="about-media">
        <Polaroid
          src="/shelby.jpg"
          alt="Shelby Mason bundled up in a winter coat, with a city skyline behind her"
          rotate={-3}
        />
        <StickyNote rotate={5} class="about-note">Hi there, I'm Shelby :)</StickyNote>
      </div>

      <div class="about-lists">
        <div>
          <h3>Expertise</h3>
          <ul>
            {skills.map((skill) => <li>{skill}</li>)}
          </ul>
        </div>
        <div>
          <h3>Familiar tools</h3>
          <ul>
            {tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </div>
        <div>
          <h3>Education</h3>
          <ul class="education-list">
            {
              education.map((item) => (
                <li>
                  <strong>{item.school}</strong>
                  <span>{item.program}</span>
                  <span class="detail">{item.detail}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-7);
  }

  .tagline {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .quick-facts {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
  }

  .quick-facts li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
  }

  .fact-emoji {
    flex: none;
    width: 1.4em;
    text-align: center;
  }

  .quick-facts :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .tilde {
    font-family: var(--font-hand);
    font-size: 1.6rem;
    line-height: 1;
    color: var(--color-accent-soft);
    margin: var(--space-4) 0 var(--space-3);
  }

  .about-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-6);
  }

  /* the note overlaps the photo's lower corner, like it was stuck on after */
  .about-media {
    position: relative;
    width: fit-content;
    margin-right: var(--space-5);
    padding-bottom: var(--space-5);
  }

  .about-media :global(.about-note) {
    position: absolute;
    right: -4.75rem;
    bottom: -2.25rem;
    z-index: 2;
    width: 12rem;
    min-height: 9.5rem;
  }

  .about-lists {
    width: 100%;
  }

  .about-lists h3 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .about-lists > div {
    margin-bottom: var(--space-5);
  }

  .about-lists ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .about-lists li {
    /* a touch of warmth so the chips separate from the white sheet */
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: var(--space-1) var(--space-3);
    font-size: 0.9rem;
  }

  .education-list li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    background: none;
    border: none;
    padding: 0;
  }

  .education-list .detail {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 800px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .about-side {
      align-items: flex-start;
    }

    .about-media {
      margin: 0 auto;
    }

    /* the note's overhang runs off a phone screen, so tuck it in closer */
    .about-media :global(.about-note) {
      right: -1rem;
      bottom: -1.5rem;
    }
  }
</style>
