---
interface Props {
  /** degrees of tilt; small numbers look most natural */
  rotate?: number;
  class?: string;
}

const { rotate = -4, class: className = '' } = Astro.props;
---

<div class={`sticky-note ${className}`} style={`--rotate: ${rotate}deg`}>
  <span class="tape" aria-hidden="true"></span>
  <p><slot /></p>
</div>

<style>
  .sticky-note {
    position: relative;
    width: 12.5rem;
    min-height: 10.5rem;
    padding: var(--space-5) var(--space-4) var(--space-4);
    background: var(--color-note);
    border: 1px solid var(--color-note-edge);
    transform: rotate(var(--rotate));
    box-shadow: 3px 4px 10px rgba(43, 34, 38, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tape {
    position: absolute;
    top: -0.55rem;
    left: 50%;
    width: 3.25rem;
    height: 1.1rem;
    transform: translateX(-50%) rotate(-3deg);
    background: rgba(43, 34, 38, 0.82);
  }

  /* Real handwriting is never perfectly level or evenly weighted: the text
     sits at a slight angle to the note, rides a touch above the baseline,
     and uses ink rather than pure black. */
  .sticky-note p {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1.2rem;
    line-height: 1.55;
    letter-spacing: 0.01em;
    word-spacing: 0.08em;
    color: var(--color-ink);
    text-align: center;
    transform: rotate(-1.2deg);
    text-wrap: balance;
    opacity: 0.92;
  }
</style>
