---
import { site } from '../data/site.config';
import SocialLinks from './SocialLinks.astro';
import Squiggle from './Squiggle.astro';

const formAction = `https://formspree.io/f/${site.formspreeFormId}`;
---

<section id="contact">
  <div class="container contact-grid">
    <div class="prose">
      <h2>Get in touch <span class="heading-emoji" aria-hidden="true">💌</span></h2>
      <Squiggle width={165} />
      <p>
        Have a project in mind or just want to say hello? Send me a message, or reach me directly at{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
      <SocialLinks class="contact-socials" />
    </div>

    <form
      id="contact-form"
      action={formAction}
      method="POST"
      data-formspree
    >
      <label for="name">Name</label>
      <input type="text" id="name" name="name" required />

      <label for="email">Email</label>
      <input type="email" id="email" name="email" required />

      <label for="message">Message</label>
      <textarea id="message" name="message" rows="5" required></textarea>

      <input type="text" name="_gotcha" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="hidden" name="_subject" value={`New message from ${site.name} portfolio`} />

      <button type="submit" class="btn">Send message</button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = form?.querySelector<HTMLParagraphElement>('.form-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    const data = new FormData(form);
    status.textContent = 'Sending…';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        status.textContent = "Thanks! I'll get back to you soon.";
        form.reset();
      } else {
        status.textContent = 'Something went wrong. Please try emailing directly instead.';
      }
    } catch {
      status.textContent = 'Something went wrong. Please try emailing directly instead.';
    }
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: start;
  }

  :global(.contact-socials) {
    margin-top: var(--space-4);
  }

  .heading-emoji {
    font-size: 0.6em;
    vertical-align: middle;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  label {
    font-size: 0.9rem;
    font-weight: 600;
    margin-top: var(--space-2);
  }

  input,
  textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
  }

  input:focus,
  textarea:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  button {
    margin-top: var(--space-3);
    align-self: flex-start;
  }

  .form-status {
    min-height: 1.2rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (max-width: 800px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
