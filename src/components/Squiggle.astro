---
/** Hand-drawn underline accent, sits beneath a section heading. */
interface Props {
  width?: number;
  class?: string;
}

const { width = 160, class: className = '' } = Astro.props;
---

<svg
  class={`squiggle ${className}`}
  width={width}
  height="12"
  viewBox="0 0 160 12"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M2 8.2C22 3.6 44 3.1 66 5.4c18 1.9 36 4.2 54 2.2 12-1.3 24-3.6 38-5.1"
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linecap="round"
  />
</svg>

<style>
  .squiggle {
    display: block;
    color: var(--color-accent-soft);
    margin-top: calc(var(--space-1) * -1);
    margin-bottom: var(--space-4);
    max-width: 100%;
    opacity: 0.85;
  }
</style>
