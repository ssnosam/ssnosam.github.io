---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  /** degrees of tilt; small numbers look most natural */
  rotate?: number;
  class?: string;
}

const { src, alt, caption, rotate = -3, class: className = '' } = Astro.props;
---

<figure class={`polaroid ${className}`} style={`--rotate: ${rotate}deg`}>
  <img src={src} alt={alt} loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  /* Classic instant-film proportions: thin border on three sides, deep
     margin below the image for the caption. */
  .polaroid {
    width: 14.5rem;
    margin: 0;
    padding: 0.85rem 0.85rem 0.5rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    transform: rotate(var(--rotate));
    box-shadow:
      0 1px 2px rgba(43, 34, 38, 0.1),
      0 8px 22px rgba(43, 34, 38, 0.12);
  }

  .polaroid img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    /* bias the crop upward so a face near the top of the frame survives it */
    object-position: center 22%;
    background: var(--color-bg);
  }

  figcaption {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.6rem;
    font-family: var(--font-hand);
    font-size: 1.2rem;
    color: var(--color-ink);
    text-align: center;
  }
</style>
