---
import '../styles/global.css';
import { site } from '../data/site.config';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      // Before first paint, so content is never hidden for anyone without JS.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <div class="page-sheet">
      <slot />
    </div>

    <script>
      // Reveal content as it enters the viewport. Anything already on screen at
      // load is shown straight away with its stagger intact; everything below
      // waits until it is scrolled to, then stops being observed.
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          // Start a little before the element is fully on screen so the motion
          // finishes about when it reaches a comfortable reading position.
          { rootMargin: '0px 0px -10% 0px', threshold: 0.01 }
        );

        items.forEach((el) => observer.observe(el));

        // The observer only fires when an element's intersection actually
        // changes. A jump that carries something from below the fold to above
        // it in one step never intersects, so that content would stay
        // invisible: reachable by scrolling back, but blank in the meantime.
        // This sweep catches anything already at or past the fold and detaches
        // itself once there is nothing left to reveal.
        let pending = items.length;
        const sweep = () => {
          pending = 0;
          items.forEach((el) => {
            if (el.classList.contains('is-visible')) return;
            if (el.getBoundingClientRect().top < window.innerHeight) {
              el.classList.add('is-visible');
              observer.unobserve(el);
            } else {
              pending += 1;
            }
          });
          if (pending === 0) window.removeEventListener('scroll', onScroll);
        };

        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            sweep();
            ticking = false;
          });
        };

        window.addEventListener('scroll', onScroll, { passive: true });
      }

      // A hash landing (say /work#philosophy) skips past sections that were
      // never scrolled through, so anything above the target would sit hidden.
      // Reveal everything up to the scroll position once the jump has settled.
      if (location.hash) {
        requestAnimationFrame(() => {
          document.querySelectorAll<HTMLElement>('.reveal:not(.is-visible)').forEach((el) => {
            if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('is-visible');
          });
        });
      }
    </script>
  </body>
</html>
